+// Binary archive data is an optional footer after the original MSL cache EOF.
+// Invalid/obsolete native data never prevents source-based pipeline compilation.
+static NSURL* mvkBinaryArchiveTempURL() {
+    return [NSURL fileURLWithPath:[NSTemporaryDirectory() stringByAppendingPathComponent:
+        [NSString stringWithFormat:@"nxemu-metal-%@.bin", [[NSUUID UUID] UUIDString]]]];
+}
