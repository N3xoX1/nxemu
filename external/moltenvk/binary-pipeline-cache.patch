+void MVKPipelineCache::attachBinaryArchives(MTLRenderPipelineDescriptor* descriptor) {
+    if (!_binaryArchivesEnabled) { return; }
+    if (@available(macOS 11.0, iOS 14.0, tvOS 14.0, *)) {
+        lock_guard<mutex> lock(_binaryArchiveLock);
+        descriptor.binaryArchives = [[_readBinaryArchives copy] autorelease];
+    }
+}
+void MVKPipelineCache::attachBinaryArchives(MTLComputePipelineDescriptor* descriptor) {
+    if (!_binaryArchivesEnabled) { return; }
+    if (@available(macOS 11.0, iOS 14.0, tvOS 14.0, *)) {
+        lock_guard<mutex> lock(_binaryArchiveLock);
+        descriptor.binaryArchives = [[_readBinaryArchives copy] autorelease];
+    }
+}
+void MVKPipelineCache::recordBinaryPipeline(MTLRenderPipelineDescriptor* descriptor) {
+    recordBinaryPipeline((id)descriptor, false);
+}
+void MVKPipelineCache::recordBinaryPipeline(MTLComputePipelineDescriptor* descriptor) {
+    recordBinaryPipeline((id)descriptor, true);
+}
+void MVKPipelineCache::recordBinaryPipeline(id descriptor, bool compute) {
+    if (!_binaryArchivesEnabled) { return; }
+    if (@available(macOS 11.0, iOS 14.0, tvOS 14.0, *)) {
+        shared_lock<shared_mutex> gate(_shaderCacheLock);
+        if (_pendingBinaryArchives.fetch_add(1) >= 64) {
+            _pendingBinaryArchives.fetch_sub(1);
+            return; // Optional persistence must never backpressure rendering.
+        }
+        id copy = [descriptor copy];
+        {
+            lock_guard<mutex> lock(_shaderCacheMapLock);
+            markDirty();
+        }
+        dispatch_group_async(_binaryArchiveGroup, _binaryArchiveQueue, ^{
+            @autoreleasepool {
+                lock_guard<mutex> lock(_binaryArchiveLock);
+                if (!_writeBinaryArchive) {
+                    MTLBinaryArchiveDescriptor* desc = [MTLBinaryArchiveDescriptor new];
+                    NSError* error = nil;
+                    // Load the mutable base lazily on the recording queue. Keeping
+                    // its backing file alive permits subsequent serialization.
+                    desc.url = _writeBinaryArchiveURL;
+                    _writeBinaryArchive = [getMTLDevice() newBinaryArchiveWithDescriptor:desc error:&error];
+                    _writeArchiveHasBase = _writeBinaryArchive && desc.url;
+                    if (!_writeBinaryArchive && desc.url) {
+                        desc.url = nil;
+                        _writeBinaryArchive = [getMTLDevice() newBinaryArchiveWithDescriptor:desc error:&error];
+                    }
+                    [desc release];
+                }
+                NSError* error = nil;
+                BOOL added = compute
+                    ? [_writeBinaryArchive addComputePipelineFunctionsWithDescriptor:copy error:&error]
+                    : [_writeBinaryArchive addRenderPipelineFunctionsWithDescriptor:copy error:&error];
+                if (added) { _binaryArchiveDirty = true; }
+                [copy release];
+                _pendingBinaryArchives.fetch_sub(1);
+            }
+        });
+    }
+}
+void MVKPipelineCache::prepareBinaryArchiveData() {
+    // Called with the lifecycle gate exclusive. Record jobs do not take that gate.
+    // No new job can be submitted while this coherent snapshot is being created.
+    dispatch_group_wait(_binaryArchiveGroup, DISPATCH_TIME_FOREVER);
+    lock_guard<mutex> lock(_binaryArchiveLock);
+    if (!_binaryArchiveDirty) { return; }
+    vector<vector<uint8_t>> blobs = _extraBinaryArchives;
+    if (_writeBinaryArchive) {
+        NSURL* url = mvkBinaryArchiveTempURL();
+        NSError* error = nil;
+        if ([_writeBinaryArchive serializeToURL:url error:&error]) {
+            NSData* data = [NSData dataWithContentsOfURL:url];
+            if (data && data.length <= 256ULL * 1024 * 1024) {
+                auto first = (const uint8_t*)data.bytes;
+                vector<uint8_t> recorded(first, first + data.length);
+                if (_writeArchiveHasBase && !blobs.empty()) {
+                    blobs.front() = std::move(recorded);
+                } else {
+                    blobs.insert(blobs.begin(), std::move(recorded));
+                }
+            }
+        }
+        [[NSFileManager defaultManager] removeItemAtURL:url error:nil];
+    }
+    if (blobs.empty()) { return; }
+    // Merged caches can contain many distinct archives. Keep the complete
+    // optional footer within the same budget accepted by the loader.
+    constexpr size_t MaxPayloadBytes = 512ULL * 1024 * 1024;
+    size_t payloadBytes = sizeof(uint32_t);
+    vector<vector<uint8_t>> bounded;
+    for (auto& blob : blobs) {
+        if (bounded.size() >= 32 || payloadBytes > MaxPayloadBytes - sizeof(uint64_t) || blob.size() > MaxPayloadBytes - payloadBytes - sizeof(uint64_t)) {
+            continue;
+        }
+        payloadBytes += sizeof(uint64_t) + blob.size();
+        bounded.push_back(std::move(blob));
+    }
+    blobs = std::move(bounded);
+    if (blobs.empty()) { return; }
+    vector<uint8_t> payload;
+    payload.reserve(payloadBytes);
+    auto append = [&](const void* data, size_t size) {
+        auto first = (const uint8_t*)data;
+        payload.insert(payload.end(), first, first + size);
+    };
+    uint32_t count = NSSwapHostIntToLittle(static_cast<uint32_t>(blobs.size()));
+    append(&count, sizeof(count));
+    for (auto& blob : blobs) {
+        uint64_t size = NSSwapHostLongLongToLittle(blob.size());
+        append(&size, sizeof(size));
+        append(blob.data(), blob.size());
+    }
+    _binaryArchivePayload = std::move(payload);
+    _binaryArchiveDirty = false;
+}
+void MVKPipelineCache::loadBinaryArchiveFooter(const void* data, size_t size) {
+    if (size < 16) { return; }
+    const uint8_t* end = (const uint8_t*)data + size;
+    if (memcmp(end - 16, "NXMTLB01", 8)) { return; }
+    uint64_t payloadSize;
+    memcpy(&payloadSize, end - 8, sizeof(payloadSize));
+    payloadSize = NSSwapLittleLongLongToHost(payloadSize);
+    if (payloadSize > size - 16 || payloadSize > 512ULL * 1024 * 1024) { return; }
+    loadBinaryArchivePayload(end - 16 - payloadSize, payloadSize);
+}
+void MVKPipelineCache::loadBinaryArchivePayload(const void* data, size_t size) {
+    if (@available(macOS 11.0, iOS 14.0, tvOS 14.0, *)) {
+        if (size < sizeof(uint32_t)) { return; }
+        const uint8_t* cursor = (const uint8_t*)data;
+        size_t remaining = size;
+        auto read = [&](void* out, size_t count) {
+            if (count > remaining) { return false; }
+            memcpy(out, cursor, count); cursor += count; remaining -= count; return true;
+        };
+        uint32_t count;
+        if (!read(&count, sizeof(count))) { return; }
+        count = NSSwapLittleIntToHost(count);
+        if (count > 32) { return; }
+        lock_guard<mutex> lock(_binaryArchiveLock);
+        for (uint32_t i = 0; i < count; ++i) {
+            uint64_t length;
+            if (!read(&length, sizeof(length))) { return; }
+            length = NSSwapLittleLongLongToHost(length);
+            if (length > remaining || length > 256ULL * 1024 * 1024) { return; }
+            vector<uint8_t> blob(cursor, cursor + length);
+            cursor += length; remaining -= length;
+            if (std::find(_extraBinaryArchives.begin(), _extraBinaryArchives.end(), blob) != _extraBinaryArchives.end()) { continue; }
+            if (_readBinaryArchives.count >= 32) { continue; }
+            NSURL* url = mvkBinaryArchiveTempURL();
+            NSData* bytes = [NSData dataWithBytes:blob.data() length:blob.size()];
+            NSError* error = nil;
+            if (![bytes writeToURL:url options:NSDataWritingAtomic error:&error]) { continue; }
+            MTLBinaryArchiveDescriptor* desc = [MTLBinaryArchiveDescriptor new];
+            desc.url = url;
+            id<MTLBinaryArchive> archive = [getMTLDevice() newBinaryArchiveWithDescriptor:desc error:&error];
+            if (archive) {
+                [_readBinaryArchives addObject:archive];
+                [archive release];
+                // Preserve the original bytes if recording or serialization fails.
+                // Updating this base instead of appending a duplicate archive keeps
+                // repeated launches of the same scene from growing the cache.
+                if (!_writeBinaryArchiveURL && !_writeBinaryArchive) {
+                    _writeBinaryArchiveURL = [url retain];
+                }
+                _extraBinaryArchives.push_back(std::move(blob));
+                _binaryArchiveDirty = true;
+            }
+            [desc release];
+            if (url != _writeBinaryArchiveURL) {
+                [[NSFileManager defaultManager] removeItemAtURL:url error:nil];
+            }
+        }
+    }
+}
