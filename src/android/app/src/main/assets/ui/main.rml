<rml>
<head>
    <title>NxEmu</title>
    <link type="text/rcss" href="main.rcss"/>
</head>
<body>
    <div id="games-page" class="page hidden">
        <div id="games-topbar" class="topbar">
            <div class="logo"><img src="images/window-icon.png"/><div class="logo-name">NxEmu</div></div>
            <div class="topbar-actions">
                <div class="title-button" data-command="search"><img src="images/search.png"/></div>
                <div class="title-button" data-command="sort"><img src="images/sort.png"/></div>
                <div class="title-button" data-command="settings"><img src="images/gear.png"/></div>
            </div>
        </div>
        <div id="search-bar" class="topbar search-bar hidden">
            <div class="icon-btn" data-command="closeSearch"><img src="images/arrow-left.png"/></div>
            <div class="search-field" data-command="editSearch">
                <span id="search-text"></span><span id="search-caret" class="search-caret">|</span><span id="search-placeholder" class="search-placeholder"></span>
            </div>
            <div id="search-clear" class="icon-btn hidden" data-command="clearSearch"><img src="images/close.png"/></div>
        </div>
        <div id="library-status" class="library-status hidden"></div>
        <div id="game-scroll" class="page-scroll">
            <div id="game-list"></div>
            <div id="search-empty" class="empty-hint hidden"></div>
        </div>
        <div id="sort-backdrop" class="menu-backdrop hidden" data-command="closeSort"></div>
        <div id="sort-menu" class="popup-menu hidden"></div>
        <div class="browser-hint">
            <div id="play-hint" class="hint hidden"><span class="hint-key">A</span> <span id="hint-play" class="hint-action"></span> <span class="hint-key hint-gap">X</span> <span id="hint-options" class="hint-action"></span></div>
            <div id="settings-hint" class="hint hidden"><span class="hint-key">Y</span> <span id="hint-settings" class="hint-action"></span></div>
            <div id="touch-hint" class="hint"></div>
        </div>
    </div>
    <div id="settings-shell" class="page hidden">
        <div class="topbar-back">
            <div id="back-button" class="icon-btn" data-command="back"><img src="images/arrow-left.png"/></div>
            <div id="settings-title" class="page-title"></div>
            <div id="back-hint" class="back-hint hidden">
                <span class="hint-key">A</span> <span id="hint-select" class="hint-action"></span>
                <span class="hint-key hint-gap">B</span> <span id="hint-back" class="hint-action"></span>
            </div>
        </div>
        <div id="settings-scroll" class="page-scroll">
            <div id="settings-body"></div>
        </div>
        <div id="settings-fab" class="fab hidden" data-command="fab"><img src="images/plus.png"/></div>
    </div>
</body>
</rml>
