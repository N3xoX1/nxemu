<rml>
  <head>
    <title>NX contents</title>
    <link type="text/rcss" href="base.rcss" />
    <link type="text/rcss" href="nx_dialogs.rcss" />
  </head>
  <body class="dialog-backdrop">
    <div id="nx-contents" class="dialog nx-dialog at-list">
      <div class="dialog-header">
        <img src="images/window-icon.png" />
        <div class="dialog-title">NX contents</div>
        <div class="dialog-close" data-command="close">&#xD7;</div>
      </div>
      <div class="nx-body">
        <div class="nx-summary">
          <div class="nx-summary-texts">
            <div id="archive-title" class="nx-heading" />
            <div id="archive-name" class="nx-source-file" />
            <div id="archive-folder" class="nx-source-file" />
          </div>
          <div id="archive-size" class="nx-game-id" />
        </div>
        <div class="nx-page page-list">
          <div class="nx-text">The game, its updates and DLC in this file. The most recent update is used unless it is turned off in the game properties. Adding or removing never rewrites the game itself.</div>
          <div id="contents" class="nx-list" />
          <div id="contents-message" class="nx-note" />
        </div>
        <div class="nx-page page-work">
          <div id="work-heading" class="nx-heading" />
          <div class="progress-track"><div class="nx-fill indeterminate" /></div>
          <div id="work-detail" class="nx-note" />
          <div class="nx-text">The file stays as it was until the change is complete. Cancelling leaves it as it was.</div>
        </div>
        <div class="nx-page page-edit">
          <div class="nx-heading">Title and picture</div>
          <div class="nx-text">Customize how this game appears in the library.</div>
          <div class="nx-edit-card">
            <div id="edit-picture" class="nx-edit-picture" />
            <div class="nx-edit-fields">
              <label for="edit-title" class="nx-edit-label">Title</label>
              <input id="edit-title" class="text" type="text" maxlength="200" />
              <div class="nx-edit-actions">
                <button data-command="edit-choose-picture">Picture from a file</button>
                <button id="restore-rom-picture">Restore ROM picture</button>
              </div>
              <div id="edit-note" class="nx-note" />
            </div>
          </div>
        </div>
        <div class="nx-page page-ask">
          <div id="ask-heading" class="nx-heading" />
          <div id="ask-text" class="nx-text" />
        </div>
      </div>
      <div class="dialog-footer">
        <button class="for-list" data-command="edit-metadata">Title and picture</button>
        <button class="for-list" data-command="add-content">Add an update or DLC</button>
        <button class="for-list primary" data-command="close">Close</button>
        <button class="for-work" data-command="cancel">Cancel</button>
        <button class="for-edit" data-command="keep">Cancel</button>
        <button class="for-edit primary" data-command="save-metadata">Save</button>
        <button class="for-ask" data-command="keep">Keep it</button>
        <button class="for-ask danger" data-command="confirm-remove">Remove</button>
      </div>
    </div>
  </body>
</rml>
