<rml>
  <head>
    <title>Settings</title>
    <link type="text/rcss" href="base.rcss" />
    <link type="text/rcss" href="settings_shell.rcss" />
    <link type="text/rcss" href="directories_dialog.rcss" />
  </head>
  <body class="dialog-backdrop">
    <div class="dialog settings-dialog">
      <div class="dialog-header settings-header">
        <img src="images/window-icon.png" />
        <div class="dialog-title">Settings</div>
        <div class="settings-separator" />
        <div class="settings-categories">
          <div class="settings-category" data-command="page:general"><img src="images/sliders.png" /><div>General</div></div>
          <div class="settings-category selected"><img src="images/folder.png" /><div>Game directories</div></div>
          <div class="settings-category" data-command="page:advanced"><img src="images/gear.png" /><div>Advanced</div></div>
        </div>
        <div class="dialog-close" data-command="close">&#xD7;</div>
      </div>
      <div class="settings-body">
        <div class="settings-page">
          <div class="settings-title">Game directories</div>
          <div class="settings-text">The folders NXEmu looks for games in. The folders inside them are not searched.</div>
          <div id="directories" class="directories" />
        </div>
      </div>
      <div class="dialog-footer">
        <button class="primary footer-start" data-command="add-directory">Add a directory</button>
        <div class="settings-locked footer-start">The game directories cannot change while a game is running.</div>
        <button data-command="close">Close</button>
      </div>
    </div>
  </body>
</rml>
