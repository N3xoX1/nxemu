body
{
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--canvas);
}

img
{
    width: 160dp;
    height: 160dp;
}

#startup-text
{
    margin-top: 18dp;
    color: var(--text-muted);
}
