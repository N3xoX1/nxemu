/* The explanation of what the mouse rests on. It lies over everything and
   takes nothing from the mouse. */
body
{
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    z-index: 100;
    pointer-events: none;
}

#tip
{
    display: none;
    position: absolute;
    box-sizing: border-box;
    max-width: 290dp;
    padding: 7dp 10dp;
    border: 1dp #2c3d5c;
    border-radius: 6dp;
    background-color: #17233a;
    color: #dbe3ee;
    font-size: 13dp;
    pointer-events: none;
}

#tip.shown
{
    display: block;
}
