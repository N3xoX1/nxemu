<rml>
  <head>
    <title>Convert to NX</title>
    <link type="text/rcss" href="base.rcss" />
    <link type="text/rcss" href="nx_dialogs.rcss" />
  </head>
  <body class="dialog-backdrop">
    <div id="nx-convert" class="dialog nx-dialog at-pick">
      <div class="dialog-header">
        <img src="images/window-icon.png" />
        <div class="dialog-title">Convert to NX</div>
        <div class="dialog-close" data-command="close">&#xD7;</div>
      </div>
      <div class="nx-body">
        <div class="nx-page page-pick">
          <div class="nx-text">Each game, with its updates and DLC, becomes one .nx file that NXEmu reads directly. Drop files or folders on this window, or add them below.</div>
          <div class="nx-add-row">
            <button data-command="add-files">Add files</button>
            <button data-command="add-folder">Add a folder</button>
            <div class="nx-spacer" />
            <button data-command="clear">Clear the list</button>
          </div>
          <div id="nx-sources" class="nx-list" />
          <div class="nx-options">
            <div class="nx-option">
              <div class="nx-option-label">Compression</div>
              <div class="nx-chips">
                <div id="level-1" class="nx-chip" data-command="level:1" title="Quickest to convert">Fast</div>
                <div id="level-3" class="nx-chip" data-command="level:3" title="Balances compression and conversion time">Normal</div>
                <div id="level-13" class="nx-chip" data-command="level:13" title="Compresses the most and takes the longest">Maximum</div>
              </div>
            </div>
            <div class="nx-option">
              <div class="nx-option-label">Save to</div>
              <div id="output-folder" class="nx-option-value" />
              <div id="output-beside" class="link" data-command="output-beside">Beside the games</div>
              <button data-command="pick-output">Change</button>
            </div>
            <div class="nx-option">
              <div id="recipe-switch" class="switch on" data-command="toggle-recipe"><div class="switch-knob" /></div>
              <div class="nx-option-texts">
                <div>Keep the rebuild data</div>
                <div class="nx-option-hint">A few KB, kept inside the NX. It recreates the original DXCI or DNSP byte for byte.</div>
              </div>
            </div>
          </div>
        </div>
        <div class="nx-page page-work">
          <div id="work-heading" class="nx-heading" />
          <div class="progress-track"><div class="nx-fill indeterminate" /></div>
          <div id="work-detail" class="nx-note" />
          <div class="nx-text">The original files are only read. Cancelling leaves no partial file.</div>
        </div>
        <div class="nx-page page-done">
          <div id="result-heading" class="nx-heading" />
          <div id="result-text" class="nx-text" />
          <div id="results" class="nx-list" />
        </div>
      </div>
      <div class="dialog-footer">
        <button class="for-pick" data-command="close">Cancel</button>
        <button id="convert-button" class="for-pick primary">Convert</button>
        <button class="for-work" data-command="cancel">Cancel</button>
        <button class="for-done" data-command="again">Convert other games</button>
        <button class="for-done primary" data-command="close">Close</button>
      </div>
    </div>
  </body>
</rml>
