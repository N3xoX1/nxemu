msgstr "Linker Stick"

#: assets/controller_dialog.rml
msgid "Deadzone"
msgstr "Totzone"

#: assets/controller_dialog.rml
msgid "Range"
msgstr "Radius"

#: assets/controller_dialog.rml
msgid "Modifier range"
msgstr "Radius mit Modifikator"

#: assets/controller_dialog.rml
msgid "D-pad"
msgstr "Steuerkreuz"

#: assets/controller_dialog.rml
msgid "On, the controller shakes when games ask it to."
msgstr "Wenn aktiviert, vibriert der Controller auf Anforderung des Spiels."

#: assets/controller_dialog.rml
