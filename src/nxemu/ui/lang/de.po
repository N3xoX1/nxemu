msgstr "Handheld"

#: assets/general_dialog.rml
msgid "Resolution"
msgstr "Auflösung"

#: assets/general_dialog.rml
msgid "Window filter"
msgstr "Skalierungsfilter"

#: assets/general_dialog.rml
msgid "How the picture is fitted to the window."
msgstr "Wie das Bild an das Fenster angepasst wird."

#: assets/general_dialog.rml
#: views/main_window.cpp
