msgid "Display"
msgstr "Anzeige"

#: assets/general_dialog.rml
#: views/advanced_dialog.cpp
#: views/settings_context.cpp
msgid "Graphics device"
msgstr "Grafikgerät"

#: assets/general_dialog.rml
msgid "Console mode"
msgstr "Konsolenmodus"

#: assets/general_dialog.rml
msgid "On the television, or in the hands."
msgstr "Am Fernseher oder in der Hand."

#: assets/general_dialog.rml
msgid "As on the television: games draw up to 1080p."
msgstr "Wie am Fernseher: Spiele werden mit bis zu 1080p dargestellt."

#: assets/general_dialog.rml
#: views/main_window.cpp
#: views/settings_context.cpp
msgid "TV"
msgstr "TV"

#: assets/general_dialog.rml
msgid "As on the console's own screen: games draw 720p, which asks less of the computer."
msgstr "Wie auf dem Konsolenbildschirm: Spiele werden mit 720p dargestellt, was den Computer weniger belastet."

#: assets/general_dialog.rml
#: views/controller_dialog.cpp
#: views/main_window.cpp
