#: assets/general_dialog.rml
#: assets/profiles_dialog.rml
msgid "Advanced"
msgstr "Erweitert"

#: assets/advanced_dialog.rml
msgid "Graphics"
msgstr "Grafik"

#: assets/advanced_dialog.rml
msgid "System"
msgstr "System"

#: assets/advanced_dialog.rml
msgid "Application"
msgstr "Anwendung"

#: assets/advanced_dialog.rml
msgid "Shortcuts"
msgstr "Tastenkürzel"

#: assets/advanced_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops."
msgstr "Ein Spiel läuft: Ausgegraute Optionen können erst nach dem Beenden geändert werden."

#: assets/advanced_dialog.rml
msgid "Picture"
msgstr "Bild"

#: assets/advanced_dialog.rml
msgid "Anti-aliasing"
msgstr "Kantenglättung"

#: assets/advanced_dialog.rml
msgid "Smooths jagged edges."
msgstr "Glättet gezackte Kanten."

#: assets/advanced_dialog.rml
msgid "Anisotropic filtering"
msgstr "Anisotrope Filterung"

#: assets/advanced_dialog.rml
msgid "Keeps textures sharp seen at a slant."
msgstr "Hält schräg betrachtete Texturen scharf."

#: assets/advanced_dialog.rml
msgid "Accuracy"
msgstr "Genauigkeit"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Accuracy level"
msgstr "Genauigkeitsstufe"

#: assets/advanced_dialog.rml
msgid "How closely the graphics chip is imitated."
msgstr "Wie genau der Grafikchip emuliert wird."

#: assets/advanced_dialog.rml
msgid "Memory reads"
msgstr "Speicherzugriffe"

#: assets/advanced_dialog.rml
msgid "How carefully the chip reads what games write."
msgstr "Wie sorgfältig der Chip die von Spielen geschriebenen Daten liest."

#: assets/advanced_dialog.rml
msgid "Command synchronization"
msgstr "Befehlssynchronisierung"

#: assets/advanced_dialog.rml
msgid "Keeps the order games give their commands in."
msgstr "Hält die Reihenfolge der von Spielen gesendeten Befehle ein."

#: assets/advanced_dialog.rml
msgid "Slower, and steadier. Off, some games show faults, hang or crash."
msgstr "Langsamer und stabiler. Ohne diese Option zeigen manche Spiele Fehler, hängen sich auf oder stürzen ab."

#: assets/advanced_dialog.rml
msgid "Reactive flushing"
msgstr "Reaktives Leeren"

#: assets/advanced_dialog.rml
msgid "Brings memory up to date when it is read."
msgstr "Aktualisiert den Speicher, wenn er gelesen wird."

#: assets/advanced_dialog.rml
msgid "More exact than guessing ahead when it will be read."
msgstr "Genauer als eine Vorhersage des Lesezeitpunkts."

#: assets/advanced_dialog.rml
msgid "Barrier feedback loops"
msgstr "Barrier-Feedback-Schleifen"

#: assets/advanced_dialog.rml
msgid "Draws transparent things right in some games."
msgstr "Stellt transparente Objekte in manchen Spielen richtig dar."

#: assets/advanced_dialog.rml
msgid "Fast GPU time"
msgstr "Schnelle GPU-Zeit"

#: assets/advanced_dialog.rml
msgid "Most games then draw their highest resolution."
msgstr "Die meisten Spiele verwenden dann ihre höchste Auflösung."

#: assets/advanced_dialog.rml
msgid "Games that lower their resolution when the chip is slow are told it is fast."
msgstr "Meldet einen schnellen Chip an Spiele, die bei einem langsamen Chip ihre Auflösung verringern."

#: assets/advanced_dialog.rml
msgid "Videos at their own speed"
msgstr "Videos mit normaler Geschwindigkeit"

#: assets/advanced_dialog.rml
msgid "Even when the speed is not limited."
msgstr "Auch wenn die Geschwindigkeit nicht begrenzt ist."

#: assets/advanced_dialog.rml
msgid "Textures and video"
msgstr "Texturen und Video"

#: assets/advanced_dialog.rml
msgid "ASTC decoding"
msgstr "ASTC-Dekodierung"

#: assets/advanced_dialog.rml
msgid "What decodes the textures of this kind."
msgstr "Was Texturen dieses Typs dekodiert."

#: assets/advanced_dialog.rml
msgid "ASTC recompression"
msgstr "ASTC-Neukomprimierung"

#: assets/advanced_dialog.rml
msgid "Less graphics memory, for a lesser picture."
msgstr "Weniger Grafikspeicher auf Kosten der Bildqualität."

#: assets/advanced_dialog.rml
msgid "Graphics memory"
msgstr "Grafikspeicher"

#: assets/advanced_dialog.rml
msgid "How much of it games may take."
msgstr "Wie viel davon Spiele verwenden dürfen."

#: assets/advanced_dialog.rml
msgid "Video decoding"
msgstr "Videodekodierung"

#: assets/advanced_dialog.rml
msgid "What decodes the videos of games."
msgstr "Was die Videos der Spiele dekodiert."

#: assets/advanced_dialog.rml
msgid "Shaders"
msgstr "Shader"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Keep shaders on the disk"
msgstr "Shader auf dem Datenträger speichern"

#: assets/advanced_dialog.rml
msgid "Games stutter less from their second start."
msgstr "Spiele ruckeln ab dem zweiten Start weniger."

#: assets/advanced_dialog.rml
msgid "Off only to look for a fault."
msgstr "Nur zur Fehlersuche deaktivieren."

#: assets/advanced_dialog.rml
msgid "Driver pipeline cache"
msgstr "Pipeline-Cache des Treibers"

#: assets/advanced_dialog.rml
msgid "Shaders load faster with some drivers."
msgstr "Shader werden mit manchen Treibern schneller geladen."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Build shaders in the background"
msgstr "Shader im Hintergrund kompilieren"

#: assets/advanced_dialog.rml
msgid "Less stutter; things can show late. A hack."
msgstr "Weniger Ruckeln; Objekte können verspätet erscheinen. Eine Behelfslösung."

#: assets/advanced_dialog.rml
msgid "Performance"
msgstr "Leistung"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Graphics on their own thread"
msgstr "Grafik in einem eigenen Thread"

#: assets/advanced_dialog.rml
msgid "Should stay on."
msgstr "Sollte aktiviert bleiben."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Presentation on its own thread"
msgstr "Bildausgabe in einem eigenen Thread"

#: assets/advanced_dialog.rml
msgid "A little faster on some computers."
msgstr "Auf manchen Computern etwas schneller."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Keep the graphics device busy"
msgstr "Grafikgerät beschäftigt halten"

#: assets/advanced_dialog.rml
msgid "So that it does not slow its clock. Uses more power."
msgstr "Verhindert eine Absenkung der Taktfrequenz. Verbraucht mehr Strom."

#: assets/advanced_dialog.rml
msgid "Processor and memory"
msgstr "Prozessor und Speicher"

#: assets/advanced_dialog.rml
msgid "Processor engine"
msgstr "Prozessor-Engine"

#: assets/advanced_dialog.rml
msgid "How the game's code is run."
msgstr "Wie der Spielcode ausgeführt wird."

#: assets/advanced_dialog.rml
msgid "Processor accuracy"
msgstr "Prozessorgenauigkeit"

#: assets/advanced_dialog.rml
msgid "For the engine that translates the code."
msgstr "Für die Engine, die den Code übersetzt."

#: assets/advanced_dialog.rml
msgid "Console memory"
msgstr "Konsolenspeicher"

#: assets/advanced_dialog.rml
msgid "More than the console has: for heavy mods."
msgstr "Mehr als die Konsole hat: für aufwendige Mods."

#: assets/advanced_dialog.rml
msgid "Multicore"
msgstr "Mehrkernbetrieb"

#: assets/advanced_dialog.rml
msgid "The cores of the console on as many threads."
msgstr "Die Kerne der Konsole auf ebenso vielen Threads."

#: assets/advanced_dialog.rml
msgid "Off, games run on one thread: much slower, to look for a fault."
msgstr "Ohne diese Option laufen Spiele in einem Thread: viel langsamer, zur Fehlersuche."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "CPU and system in step"
msgstr "CPU und System synchronisieren"

#: assets/advanced_dialog.rml
msgid "Keeps the processor and the system's answers in order."
msgstr "Hält die Reihenfolge zwischen Prozessor und Systemantworten ein."

#: assets/advanced_dialog.rml
msgid "Needs multicore."
msgstr "Benötigt den Mehrkernbetrieb."

#: assets/advanced_dialog.rml
msgid "Emulation"
msgstr "Emulation"

#: assets/advanced_dialog.rml
#: views/hotkeys.h
#: views/settings_context.cpp
msgid "Limit speed"
msgstr "Geschwindigkeit begrenzen"

#: assets/advanced_dialog.rml
msgid "Off: as fast as the computer can."
msgstr "Deaktiviert: so schnell, wie der Computer kann."

#: assets/advanced_dialog.rml
msgid "On, games run at the speed chosen: 100% is the speed of the console."
msgstr "Wenn aktiviert, laufen Spiele mit der gewählten Geschwindigkeit: 100 % entspricht der Konsole."

#: assets/advanced_dialog.rml
#: assets/general_dialog.rml
msgid "Audio"
msgstr "Audio"

#: assets/advanced_dialog.rml
msgid "Output engine"
msgstr "Ausgabe-Engine"

#: assets/advanced_dialog.rml
msgid "What plays the sound on this computer."
msgstr "Was den Ton auf diesem Computer wiedergibt."

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Input device"
msgstr "Eingabegerät"

#: assets/advanced_dialog.rml
msgid "The microphone games listen to."
msgstr "Das von Spielen verwendete Mikrofon."

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Vibration"
msgstr "Vibration"

#: assets/advanced_dialog.rml
msgid "For every player. Each has a switch of their own."
msgstr "Für alle Spieler. Jeder hat zusätzlich einen eigenen Schalter."

#: assets/advanced_dialog.rml
msgid "Accurate vibration"
msgstr "Genaue Vibration"

#: assets/advanced_dialog.rml
msgid "Every change is sent: some controllers lag."
msgstr "Jede Änderung wird gesendet: Manche Controller reagieren verzögert."

#: assets/advanced_dialog.rml
msgid "Behaviour"
msgstr "Verhalten"

#: assets/advanced_dialog.rml
#: views/main_window.cpp
msgid "Start games in fullscreen"
msgstr "Spiele im Vollbild starten"

#: assets/advanced_dialog.rml
#: views/main_window.cpp
msgid "Start games with UI hidden"
msgstr "Spiele mit ausgeblendeter Oberfläche starten"

#: assets/advanced_dialog.rml
msgid "Confirm before stopping"
msgstr "Vor dem Beenden nachfragen"

#: assets/advanced_dialog.rml
msgid "Asks before a running game is stopped."
msgstr "Fragt vor dem Beenden eines laufenden Spiels nach."

#: assets/advanced_dialog.rml
msgid "Discord presence"
msgstr "Discord-Präsenz"

#: assets/advanced_dialog.rml
msgid "Shows what you play in Discord when it runs."
msgstr "Zeigt in Discord an, was du spielst, wenn Discord läuft."

#: assets/advanced_dialog.rml
msgid "Log"
msgstr "Protokoll"

#: assets/advanced_dialog.rml
msgid "Show the log console"
msgstr "Protokollkonsole anzeigen"

#: assets/advanced_dialog.rml
msgid "The log is also written as it comes."
msgstr "Das Protokoll wird auch fortlaufend angezeigt."

#: assets/advanced_dialog.rml
msgid "Log filter"
msgstr "Protokollfilter"

#: assets/advanced_dialog.rml
msgid "What is written, as class:level."
msgstr "Was protokolliert wird, im Format Klasse:Stufe."

#: assets/advanced_dialog.rml
msgid "Click a shortcut, then press its keys. A click elsewhere keeps it as it is."
msgstr "Klicken Sie auf ein Tastenkürzel und drücken Sie dann die Tasten. Ein Klick woanders lässt es unverändert."

#: assets/advanced_dialog.rml
msgid "In game"
msgstr "Im Spiel"

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Restore defaults"
msgstr "Standardwerte wiederherstellen"

#: assets/advanced_dialog.rml
msgid "Inherit all settings"
msgstr "Alle Einstellungen übernehmen"

#: assets/advanced_dialog.rml
msgid "Restore the defaults of all the tabs?"
msgstr "Die Standardwerte aller Tabs wiederherstellen?"

#: assets/advanced_dialog.rml
msgid "Remove your overrides and re-enable NXEmu settings for this game?"
msgstr "Deine Anpassungen entfernen und die NXEmu-Einstellungen für dieses Spiel wieder aktivieren?"

#: assets/advanced_dialog.rml
#: assets/profiles_dialog.rml
msgid "Keep"
msgstr "Beibehalten"

#: assets/advanced_dialog.rml
msgid "Restore"
msgstr "Wiederherstellen"

