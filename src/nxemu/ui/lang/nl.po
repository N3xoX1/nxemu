#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Output mode"
msgstr "Uitgangsmodus"

#: assets/general_dialog.rml
msgid "Surround needs speakers that play it."
msgstr "Voor surroundgeluid zijn compatibele luidsprekers vereist."

#: assets/general_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops, and the languages and the audio output are read when a game starts."
msgstr "Er draait een spel: grijs weergegeven opties kunnen pas na het stoppen worden gewijzigd. Talen en audio-uitvoer worden bij de start van een spel overgenomen."

