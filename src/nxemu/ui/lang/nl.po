#: assets/general_dialog.rml
#: assets/profiles_dialog.rml
msgid "Advanced"
msgstr "Geavanceerd"

#: assets/advanced_dialog.rml
msgid "Graphics"
msgstr "Grafische instellingen"

#: assets/advanced_dialog.rml
msgid "System"
msgstr "Systeem"

#: assets/advanced_dialog.rml
msgid "Application"
msgstr "Toepassing"

#: assets/advanced_dialog.rml
msgid "Shortcuts"
msgstr "Sneltoetsen"

#: assets/advanced_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops."
msgstr "Er draait een spel: grijs weergegeven opties kunnen pas na het stoppen worden gewijzigd."

#: assets/advanced_dialog.rml
msgid "Picture"
msgstr "Beeld"

#: assets/advanced_dialog.rml
msgid "Anti-aliasing"
msgstr "Anti-aliasing"

#: assets/advanced_dialog.rml
msgid "Smooths jagged edges."
msgstr "Maakt gekartelde randen glad."

#: assets/advanced_dialog.rml
msgid "Anisotropic filtering"
msgstr "Anisotrope filtering"

#: assets/advanced_dialog.rml
msgid "Keeps textures sharp seen at a slant."
msgstr "Behoudt de scherpte van texturen vanuit een hoek."

#: assets/advanced_dialog.rml
msgid "Accuracy"
msgstr "Nauwkeurigheid"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Accuracy level"
msgstr "Precisieniveau"

#: assets/advanced_dialog.rml
msgid "How closely the graphics chip is imitated."
msgstr "De betrouwbaarheid waarmee de grafische chip wordt geëmuleerd."

#: assets/advanced_dialog.rml
msgid "Memory reads"
msgstr "Geheugen lezen"

#: assets/advanced_dialog.rml
msgid "How carefully the chip reads what games write."
msgstr "Hoe strikt de chip gegevens leest die door games zijn geschreven."

#: assets/advanced_dialog.rml
msgid "Command synchronization"
msgstr "Commandosynchronisatie"

#: assets/advanced_dialog.rml
msgid "Keeps the order games give their commands in."
msgstr "Respecteert de volgorde van opdrachten die door games worden verzonden."

#: assets/advanced_dialog.rml
msgid "Slower, and steadier. Off, some games show faults, hang or crash."
msgstr "Langzamer, maar stabieler. Zonder deze optie vertonen sommige spellen fouten, lopen ze vast of crashen ze."

#: assets/advanced_dialog.rml
msgid "Reactive flushing"
msgstr "Reactief flushen"

#: assets/advanced_dialog.rml
msgid "Brings memory up to date when it is read."
msgstr "Werkt het geheugen bij terwijl het wordt gelezen."

#: assets/advanced_dialog.rml
msgid "More exact than guessing ahead when it will be read."
msgstr "Nauwkeuriger dan voorspellen wanneer het geheugen gelezen zal worden."

#: assets/advanced_dialog.rml
msgid "Barrier feedback loops"
msgstr "Barrière-feedbacklussen"

#: assets/advanced_dialog.rml
msgid "Draws transparent things right in some games."
msgstr "Geeft transparante elementen correct weer in sommige games."

#: assets/advanced_dialog.rml
msgid "Fast GPU time"
msgstr "Snelle GPU-tijd"

#: assets/advanced_dialog.rml
msgid "Most games then draw their highest resolution."
msgstr "De meeste games gebruiken dan hun maximale resolutie."

#: assets/advanced_dialog.rml
msgid "Games that lower their resolution when the chip is slow are told it is fast."
msgstr "Meldt een snelle grafische chip aan spellen die bij een trage chip hun resolutie verlagen."

#: assets/advanced_dialog.rml
msgid "Videos at their own speed"
msgstr "Video's op normale snelheid"

#: assets/advanced_dialog.rml
msgid "Even when the speed is not limited."
msgstr "Zelfs als de snelheid niet beperkt is."

#: assets/advanced_dialog.rml
msgid "Textures and video"
msgstr "Texturen en video"

#: assets/advanced_dialog.rml
msgid "ASTC decoding"
msgstr "ASTC decoderen"

#: assets/advanced_dialog.rml
msgid "What decodes the textures of this kind."
msgstr "Welke texturen van dit type decodeert."

#: assets/advanced_dialog.rml
msgid "ASTC recompression"
msgstr "Hercompressie ASTC"

#: assets/advanced_dialog.rml
msgid "Less graphics memory, for a lesser picture."
msgstr "Minder grafisch geheugen, ten koste van een minder natuurgetrouw beeld."

#: assets/advanced_dialog.rml
msgid "Graphics memory"
msgstr "Grafisch geheugen"

#: assets/advanced_dialog.rml
msgid "How much of it games may take."
msgstr "De hoeveelheid die games kunnen gebruiken."

#: assets/advanced_dialog.rml
msgid "Video decoding"
msgstr "Videodecodering"

#: assets/advanced_dialog.rml
msgid "What decodes the videos of games."
msgstr "Welke gamevideo's decodeert."

#: assets/advanced_dialog.rml
msgid "Shaders"
msgstr "Shaders"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Keep shaders on the disk"
msgstr "Shaders op schijf bewaren"

#: assets/advanced_dialog.rml
msgid "Games stutter less from their second start."
msgstr "Spellen haperen minder vanaf de tweede keer dat je ze start."

#: assets/advanced_dialog.rml
msgid "Off only to look for a fault."
msgstr "Alleen uitschakelen om problemen op te lossen."

#: assets/advanced_dialog.rml
msgid "Driver pipeline cache"
msgstr "Pipelinecache van het stuurprogramma"

#: assets/advanced_dialog.rml
msgid "Shaders load faster with some drivers."
msgstr "Shaders laden sneller met sommige stuurprogramma's."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Build shaders in the background"
msgstr "Shaders op de achtergrond compileren"

#: assets/advanced_dialog.rml
msgid "Less stutter; things can show late. A hack."
msgstr "Minder schokkerigheid; sommige items kunnen te laat verschijnen. Een benadering."

#: assets/advanced_dialog.rml
msgid "Performance"
msgstr "Prestaties"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Graphics on their own thread"
msgstr "Grafische verwerking in een eigen thread"

#: assets/advanced_dialog.rml
msgid "Should stay on."
msgstr "Laat ingeschakeld."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Presentation on its own thread"
msgstr "Beeldweergave in een eigen thread"

#: assets/advanced_dialog.rml
msgid "A little faster on some computers."
msgstr "Op sommige computers iets sneller."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Keep the graphics device busy"
msgstr "Houd het grafische apparaat bezig"

#: assets/advanced_dialog.rml
msgid "So that it does not slow its clock. Uses more power."
msgstr "Voorkomt dat de frequentie wordt verlaagd. Verbruikt meer energie."

#: assets/advanced_dialog.rml
msgid "Processor and memory"
msgstr "Processor en geheugen"

#: assets/advanced_dialog.rml
msgid "Processor engine"
msgstr "Processor-engine"

#: assets/advanced_dialog.rml
msgid "How the game's code is run."
msgstr "De manier waarop de spelcode wordt uitgevoerd."

#: assets/advanced_dialog.rml
msgid "Processor accuracy"
msgstr "Processornauwkeurigheid"

#: assets/advanced_dialog.rml
msgid "For the engine that translates the code."
msgstr "Voor de engine die de code vertaalt."

#: assets/advanced_dialog.rml
msgid "Console memory"
msgstr "Consolegeheugen"

#: assets/advanced_dialog.rml
msgid "More than the console has: for heavy mods."
msgstr "Meer dan op de console: voor veeleisende mods."

#: assets/advanced_dialog.rml
msgid "Multicore"
msgstr "Multicore"

#: assets/advanced_dialog.rml
msgid "The cores of the console on as many threads."
msgstr "Elke consolekern draait in een eigen thread."

#: assets/advanced_dialog.rml
msgid "Off, games run on one thread: much slower, to look for a fault."
msgstr "Uitgeschakeld draaien spellen in één thread. Veel langzamer; bedoeld voor foutopsporing."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "CPU and system in step"
msgstr "CPU en systeem synchroniseren"

#: assets/advanced_dialog.rml
msgid "Keeps the processor and the system's answers in order."
msgstr "Respecteert de volgorde tussen processor- en systeemreacties."

#: assets/advanced_dialog.rml
msgid "Needs multicore."
msgstr "Vereist multi-coremodus."

#: assets/advanced_dialog.rml
msgid "Emulation"
msgstr "Emulatie"

#: assets/advanced_dialog.rml
#: views/hotkeys.h
#: views/settings_context.cpp
msgid "Limit speed"
msgstr "Limietsnelheid"

#: assets/advanced_dialog.rml
msgid "Off: as fast as the computer can."
msgstr "Uitgeschakeld: zo snel als de computer toelaat."

#: assets/advanced_dialog.rml
msgid "On, games run at the speed chosen: 100% is the speed of the console."
msgstr "Indien ingeschakeld, draaien games op de gekozen snelheid: 100% komt overeen met de consolesnelheid."

#: assets/advanced_dialog.rml
#: assets/general_dialog.rml
msgid "Audio"
msgstr "Audio"

#: assets/advanced_dialog.rml
msgid "Output engine"
msgstr "Audio-uitvoerbackend"

#: assets/advanced_dialog.rml
msgid "What plays the sound on this computer."
msgstr "Wat geluid afspeelt op deze computer."

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Input device"
msgstr "Invoerapparaat"

#: assets/advanced_dialog.rml
msgid "The microphone games listen to."
msgstr "De microfoon die door games wordt gebruikt."

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Vibration"
msgstr "Vibratie"

#: assets/advanced_dialog.rml
msgid "For every player. Each has a switch of their own."
msgstr "Voor alle spelers. Elk heeft ook zijn eigen instelling."

#: assets/advanced_dialog.rml
msgid "Accurate vibration"
msgstr "Nauwkeurige vibratie"

#: assets/advanced_dialog.rml
msgid "Every change is sent: some controllers lag."
msgstr "Elke variatie wordt verzonden: sommige controllers reageren laat."

#: assets/advanced_dialog.rml
msgid "Behaviour"
msgstr "Gedrag"

#: assets/advanced_dialog.rml
#: views/main_window.cpp
msgid "Start games in fullscreen"
msgstr "Start games op volledig scherm"

#: assets/advanced_dialog.rml
#: views/main_window.cpp
msgid "Start games with UI hidden"
msgstr "Spellen starten met verborgen interface"

#: assets/advanced_dialog.rml
msgid "Confirm before stopping"
msgstr "Bevestigen voordat een spel stopt"

#: assets/advanced_dialog.rml
msgid "Asks before a running game is stopped."
msgstr "Vraagt om bevestiging voordat een spel dat bezig is, wordt gestopt."

#: assets/advanced_dialog.rml
msgid "Discord presence"
msgstr "Aanwezigheid Discord"

#: assets/advanced_dialog.rml
msgid "Shows what you play in Discord when it runs."
msgstr "Toont in Discord welk spel je speelt, wanneer Discord actief is."

#: assets/advanced_dialog.rml
msgid "Log"
msgstr "Logboek"

#: assets/advanced_dialog.rml
msgid "Show the log console"
msgstr "Logconsole weergeven"

#: assets/advanced_dialog.rml
msgid "The log is also written as it comes."
msgstr "Het logboek wordt daar ook weergegeven terwijl u bezig bent."

#: assets/advanced_dialog.rml
msgid "Log filter"
msgstr "Logboekfilter"

#: assets/advanced_dialog.rml
msgid "What is written, as class:level."
msgstr "Wat wordt gelogd, in de vorm klasse:niveau."

#: assets/advanced_dialog.rml
msgid "Click a shortcut, then press its keys. A click elsewhere keeps it as it is."
msgstr "Klik op een sneltoets en druk dan op de toetsen. Een klik elders laat hem ongewijzigd."

#: assets/advanced_dialog.rml
msgid "In game"
msgstr "In het spel"

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Restore defaults"
msgstr "Standaardwaarden herstellen"

#: assets/advanced_dialog.rml
msgid "Inherit all settings"
msgstr "Alle instellingen overnemen"

#: assets/advanced_dialog.rml
msgid "Restore the defaults of all the tabs?"
msgstr "De standaardwaarden van alle tabbladen herstellen?"

#: assets/advanced_dialog.rml
msgid "Remove your overrides and re-enable NXEmu settings for this game?"
msgstr "Je aanpassingen verwijderen en de NXEmu-instellingen voor deze game opnieuw inschakelen?"

#: assets/advanced_dialog.rml
#: assets/profiles_dialog.rml
msgid "Keep"
msgstr "Behouden"

#: assets/advanced_dialog.rml
msgid "Restore"
msgstr "Opnieuw uitvoeren"

