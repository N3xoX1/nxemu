#: assets/general_dialog.rml
msgid "Interface language"
msgstr "Interfacetaal"

#: assets/general_dialog.rml
msgid "On, the interface language is chosen here. Off, it follows the console language."
msgstr "Ingeschakeld wordt de interfacetaal hier gekozen. Uitgeschakeld volgt deze de consoletaal."

#: assets/general_dialog.rml
