msgstr "Opstarten zonder firmware"

#: assets/firmware_dialog.rml
msgid "Keep the installed one"
msgstr "Geïnstalleerde versie behouden"

#: assets/firmware_dialog.rml
msgid "Replace"
msgstr "Vervangen"

#: assets/firmware_dialog.rml
msgid "Choose another source"
msgstr "Kies een andere bron"

