#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
#: assets/directories_dialog.rml
#: assets/general_dialog.rml
#: assets/profiles_dialog.rml
msgid "Advanced"
msgstr "アドバンスト"

#: assets/advanced_dialog.rml
msgid "Graphics"
msgstr "グラフィックス"

#: assets/advanced_dialog.rml
msgid "System"
msgstr "システム"

#: assets/advanced_dialog.rml
msgid "Application"
msgstr "アプリケーション"

#: assets/advanced_dialog.rml
msgid "Shortcuts"
msgstr "ショートカット"

#: assets/advanced_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops."
msgstr "ゲームの実行中は、グレー表示の項目を変更できません。"

#: assets/advanced_dialog.rml
msgid "Picture"
msgstr "画像"

#: assets/advanced_dialog.rml
msgid "Anti-aliasing"
msgstr "アンチエイリアス"

#: assets/advanced_dialog.rml
msgid "Smooths jagged edges."
msgstr "ギザギザのエッジを滑らかにします。"

#: assets/advanced_dialog.rml
msgid "Anisotropic filtering"
msgstr "異方性フィルタリング"

#: assets/advanced_dialog.rml
msgid "Keeps textures sharp seen at a slant."
msgstr "斜めから見たテクスチャの鮮明さを維持します。"

#: assets/advanced_dialog.rml
msgid "Accuracy"
msgstr "精度"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Accuracy level"
msgstr "精度レベル"

#: assets/advanced_dialog.rml
msgid "How closely the graphics chip is imitated."
msgstr "グラフィックス チップがエミュレートされる忠実度。"

#: assets/advanced_dialog.rml
msgid "Memory reads"
msgstr "メモリ読み取り"

#: assets/advanced_dialog.rml
msgid "How carefully the chip reads what games write."
msgstr "チップがゲームによって書き込まれたデータをどの程度厳密に読み取るか。"

#: assets/advanced_dialog.rml
msgid "Command synchronization"
msgstr "コマンド同期"

#: assets/advanced_dialog.rml
msgid "Keeps the order games give their commands in."
msgstr "ゲームによって送信されたコマンドの順序を尊重します。"

#: assets/advanced_dialog.rml
msgid "Slower, and steadier. Off, some games show faults, hang or crash."
msgstr "低速ですが安定します。無効にすると、一部のゲームで表示の不具合、フリーズ、クラッシュが発生します。"

#: assets/advanced_dialog.rml
msgid "Reactive flushing"
msgstr "リアクティブフラッシュ"

#: assets/advanced_dialog.rml
msgid "Brings memory up to date when it is read."
msgstr "メモリの読み取り時にメモリを更新します。"

#: assets/advanced_dialog.rml
msgid "More exact than guessing ahead when it will be read."
msgstr "メモリが読み取られる時点を予測する方法より正確です。"

#: assets/advanced_dialog.rml
msgid "Barrier feedback loops"
msgstr "バリアフィードバックループ"

#: assets/advanced_dialog.rml
msgid "Draws transparent things right in some games."
msgstr "一部のゲームで透明な要素が正しく表示されます。"

#: assets/advanced_dialog.rml
msgid "Fast GPU time"
msgstr "GPU の高速時間"

#: assets/advanced_dialog.rml
msgid "Most games then draw their highest resolution."
msgstr "ほとんどのゲームは最大解像度を使用します。"

#: assets/advanced_dialog.rml
msgid "Games that lower their resolution when the chip is slow are told it is fast."
msgstr "GPU が遅いと解像度を下げるゲームに対して、GPU が高速であると通知します。"

#: assets/advanced_dialog.rml
msgid "Videos at their own speed"
msgstr "動画を通常の速度で再生"

#: assets/advanced_dialog.rml
msgid "Even when the speed is not limited."
msgstr "速度制限がない場合でも。"

#: assets/advanced_dialog.rml
msgid "Textures and video"
msgstr "テクスチャとビデオ"

#: assets/advanced_dialog.rml
msgid "ASTC decoding"
msgstr "ASTC のデコード"

#: assets/advanced_dialog.rml
msgid "What decodes the textures of this kind."
msgstr "このタイプのテクスチャをデコードします。"

#: assets/advanced_dialog.rml
msgid "ASTC recompression"
msgstr "再圧縮 ASTC"

#: assets/advanced_dialog.rml
msgid "Less graphics memory, for a lesser picture."
msgstr "グラフィックス メモリが少なくなりますが、その代わりに画像の忠実度が低くなります。"

#: assets/advanced_dialog.rml
msgid "Graphics memory"
msgstr "グラフィックス メモリ"

#: assets/advanced_dialog.rml
msgid "How much of it games may take."
msgstr "ゲームが使用できる量。"

#: assets/advanced_dialog.rml
msgid "Video decoding"
msgstr "ビデオ デコード"

#: assets/advanced_dialog.rml
msgid "What decodes the videos of games."
msgstr "ゲームビデオをデコードします。"

#: assets/advanced_dialog.rml
msgid "Shaders"
msgstr "シェーダー"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Keep shaders on the disk"
msgstr "シェーダーをディスクに保存"

#: assets/advanced_dialog.rml
msgid "Games stutter less from their second start."
msgstr "2 回目の起動からゲームのカクつきが減ります。"

#: assets/advanced_dialog.rml
msgid "Off only to look for a fault."
msgstr "トラブルシューティングを行う場合にのみ無効にします。"

#: assets/advanced_dialog.rml
msgid "Driver pipeline cache"
msgstr "ドライバーのパイプラインキャッシュ"

#: assets/advanced_dialog.rml
msgid "Shaders load faster with some drivers."
msgstr "一部のドライバーでシェーダーの読み込みが速くなります。"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Build shaders in the background"
msgstr "バックグラウンドでシェーダーをコンパイル"

#: assets/advanced_dialog.rml
msgid "Less stutter; things can show late. A hack."
msgstr "ぎくしゃく感が軽減されました。一部のアイテムは表示が遅れる場合があります。近似値。"

#: assets/advanced_dialog.rml
msgid "Performance"
msgstr "パフォーマンス"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Graphics on their own thread"
msgstr "グラフィックスを専用スレッドで処理"

#: assets/advanced_dialog.rml
msgid "Should stay on."
msgstr "有効のままにします。"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Presentation on its own thread"
msgstr "画面への出力を専用スレッドで処理"

#: assets/advanced_dialog.rml
msgid "A little faster on some computers."
msgstr "一部のコンピューターでは少し高速になります。"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Keep the graphics device busy"
msgstr "グラフィックス デバイスをビジー状態に保つ"

#: assets/advanced_dialog.rml
msgid "So that it does not slow its clock. Uses more power."
msgstr "周波数の低下を防ぎます。より多くのエネルギーを消費します。"

#: assets/advanced_dialog.rml
msgid "Processor and memory"
msgstr "プロセッサーとメモリー"

#: assets/advanced_dialog.rml
msgid "Processor engine"
msgstr "プロセッサ エンジン"

#: assets/advanced_dialog.rml
msgid "How the game's code is run."
msgstr "ゲームコードの実行方法。"

#: assets/advanced_dialog.rml
msgid "Processor accuracy"
msgstr "プロセッサーの精度"

#: assets/advanced_dialog.rml
msgid "For the engine that translates the code."
msgstr "コードを変換するエンジン用。"

#: assets/advanced_dialog.rml
msgid "Console memory"
msgstr "コンソールメモリ"

#: assets/advanced_dialog.rml
msgid "More than the console has: for heavy mods."
msgstr "コンソール以上のもの: 要求の厳しい MOD 向け。"

#: assets/advanced_dialog.rml
msgid "Multicore"
msgstr "マルチコア"

#: assets/advanced_dialog.rml
msgid "The cores of the console on as many threads."
msgstr "本体の各 CPU コアを、それぞれ別のスレッドで処理します。"

#: assets/advanced_dialog.rml
msgid "Off, games run on one thread: much slower, to look for a fault."
msgstr "無効にするとゲームを 1 つのスレッドで処理します。大幅に遅くなるため、不具合の調査用です。"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "CPU and system in step"
msgstr "CPU とシステムを同期"

#: assets/advanced_dialog.rml
msgid "Keeps the processor and the system's answers in order."
msgstr "プロセッサとシステムの応答間の順序を尊重します。"

#: assets/advanced_dialog.rml
msgid "Needs multicore."
msgstr "マルチコア モードが必要です。"

#: assets/advanced_dialog.rml
msgid "Emulation"
msgstr "エミュレーション"

#: assets/advanced_dialog.rml
#: views/hotkeys.h
#: views/settings_context.cpp
msgid "Limit speed"
msgstr "制限速度"

#: assets/advanced_dialog.rml
msgid "Off: as fast as the computer can."
msgstr "無効: コンピューターが許す限りの速度。"

#: assets/advanced_dialog.rml
msgid "On, games run at the speed chosen: 100% is the speed of the console."
msgstr "有効にすると、ゲームは選択した速度で実行されます。100% はコンソールの速度に対応します。"

#: assets/advanced_dialog.rml
#: assets/general_dialog.rml
msgid "Audio"
msgstr "サウンド"

#: assets/advanced_dialog.rml
msgid "Output engine"
msgstr "音声出力エンジン"

#: assets/advanced_dialog.rml
msgid "What plays the sound on this computer."
msgstr "このコンピュータでサウンドを再生するもの。"

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Input device"
msgstr "入力デバイス"

#: assets/advanced_dialog.rml
msgid "The microphone games listen to."
msgstr "ゲームで使用されるマイク。"

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Vibration"
msgstr "振動"

#: assets/advanced_dialog.rml
msgid "For every player. Each has a switch of their own."
msgstr "すべてのプレイヤー向け。それぞれに独自の設定もあります。"

#: assets/advanced_dialog.rml
msgid "Accurate vibration"
msgstr "正確な振動"

#: assets/advanced_dialog.rml
msgid "Every change is sent: some controllers lag."
msgstr "各バリエーションが送信されます。一部のコントローラーは反応が遅くなります。"

#: assets/advanced_dialog.rml
msgid "Behaviour"
msgstr "の動作"

#: assets/advanced_dialog.rml
#: views/main_window.cpp
msgid "Start games in fullscreen"
msgstr "全画面でゲームを開始(F)"

#: assets/advanced_dialog.rml
#: views/main_window.cpp
msgid "Start games with UI hidden"
msgstr "UI を非表示にしてゲームを起動(U)"

#: assets/advanced_dialog.rml
msgid "Confirm before stopping"
msgstr "ゲーム停止前に確認"

#: assets/advanced_dialog.rml
msgid "Asks before a running game is stopped."
msgstr "進行中のゲームを停止する前に確認を求めます。"

#: assets/advanced_dialog.rml
msgid "Discord presence"
msgstr "プレゼンス Discord"

#: assets/advanced_dialog.rml
msgid "Shows what you play in Discord when it runs."
msgstr "Discord の起動中に、プレイしているゲームを表示します。"

#: assets/advanced_dialog.rml
msgid "Log"
msgstr "ログ"

#: assets/advanced_dialog.rml
msgid "Show the log console"
msgstr "ログコンソールを表示"

#: assets/advanced_dialog.rml
msgid "The log is also written as it comes."
msgstr "ログもそこに表示されます。"

#: assets/advanced_dialog.rml
msgid "Log filter"
msgstr "ログフィルター"

#: assets/advanced_dialog.rml
msgid "What is written, as class:level."
msgstr "ログに記録する内容。形式はクラス:レベルです。"

#: assets/advanced_dialog.rml
msgid "Click a shortcut, then press its keys. A click elsewhere keeps it as it is."
msgstr "ショートカットをクリックしてからキーを押します。他の場所をクリックすると変更されません。"

#: assets/advanced_dialog.rml
msgid "In game"
msgstr "ゲーム中"

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Restore defaults"
msgstr "デフォルトに戻す"

#: assets/advanced_dialog.rml
msgid "Inherit all settings"
msgstr "すべての設定を継承"

#: assets/advanced_dialog.rml
msgid "Restore the defaults of all the tabs?"
msgstr "すべてのタブを既定値に戻しますか？"

#: assets/advanced_dialog.rml
msgid "Remove your overrides and re-enable NXEmu settings for this game?"
msgstr "カスタマイズを削除して、このゲームの NXEmu 設定を再度有効にしますか?"

#: assets/advanced_dialog.rml
#: assets/profiles_dialog.rml
msgid "Keep"
msgstr "キープ"

#: assets/advanced_dialog.rml
msgid "Restore"
msgstr "やり直し"

#: assets/advanced_dialog.rml
#: assets/directories_dialog.rml
#: assets/firmware_dialog.rml
#: assets/general_dialog.rml
#: assets/main_window.rml
#: assets/profiles_dialog.rml
#: views/firmware_dialog.cpp
msgid "Close"
msgstr "閉じる"

#: assets/controller_dialog.rml
msgid "On, games see this player's controller as plugged into the console."
msgstr "有効にすると、ゲームはこのプレーヤーのコントローラーが本体に接続されていると認識します。"

#: assets/controller_dialog.rml
msgid "Connected"
msgstr "接続の状態"

#: assets/controller_dialog.rml
msgid "Controller"
msgstr "コントローラー"

#: assets/controller_dialog.rml
#: views/controller_dialog.cpp
msgid "Left stick"
msgstr "左スティック"

#: assets/controller_dialog.rml
msgid "Deadzone"
msgstr "遊び"

#: assets/controller_dialog.rml
msgid "Range"
msgstr "可動範囲"

#: assets/controller_dialog.rml
msgid "Modifier range"
msgstr "補助キー使用時の範囲"

#: assets/controller_dialog.rml
msgid "D-pad"
msgstr "方向パッド"

#: assets/controller_dialog.rml
msgid "On, the controller shakes when games ask it to."
msgstr "有効にすると、ゲームが要求したときにコントローラーが振動します。"

#: assets/controller_dialog.rml
msgid "Face buttons"
msgstr "アクションボタン"

#: assets/controller_dialog.rml
#: views/controller_dialog.cpp
msgid "Right stick"
msgstr "右スティック"

#: assets/controller_dialog.rml
msgid "Asks for each control in turn"
msgstr "各コマンドを順番に要求します"

#: assets/controller_dialog.rml
msgid "Bind all controls"
msgstr "すべての操作を割り当て"

#: assets/controller_dialog.rml
msgid "Binds this player's controls as the input device suggests"
msgstr "入力デバイスの推奨設定に従って、このプレイヤーの操作を割り当てます"

#: assets/controller_dialog.rml
#: assets/firmware_dialog.rml
msgid "Cancel"
msgstr "キャンセル"

#: assets/controller_dialog.rml
msgid "Save"
msgstr "保存"

#: assets/directories_dialog.rml
msgid "The folders NXEmu looks for games in. The folders inside them are not searched."
msgstr "NXEmu がゲームを検索するフォルダー。そのサブフォルダーは参照されません。"

#: assets/directories_dialog.rml
msgid "Add a directory"
msgstr "フォルダーを追加"

#: assets/directories_dialog.rml
msgid "The game directories cannot change while a game is running."
msgstr "ゲームの進行中はゲームフォルダーを編集できません。"

#: assets/firmware_dialog.rml
msgid "Install firmware"
msgstr "ファームウェアをインストールする"

#: assets/firmware_dialog.rml
msgid "Source"
msgstr "ソース"

#: assets/firmware_dialog.rml
msgid "Install"
msgstr "インストール"

#: assets/firmware_dialog.rml
msgid "Finish"
msgstr "終了"

#: assets/firmware_dialog.rml
msgid "Where is the firmware?"
msgstr "ファームウェアはどこにありますか?"

#: assets/firmware_dialog.rml
msgid "Most games need the console's firmware. Choose the package to install it from, or drop it on this window."
msgstr "ほとんどのゲームにはコンソールのファームウェアが必要です。インストールするファイルを選択するか、このウィンドウにドロップします。"

#: assets/firmware_dialog.rml
msgid "Firmware file"
msgstr "ファームウェア ファイル"

#: assets/firmware_dialog.rml
msgid "A .zip archive, or a .dxci game card image that carries an update"
msgstr "アップデートを含む .zip アーカイブまたは .dxci ゲーム カード イメージ"

#: assets/firmware_dialog.rml
msgid "Browse"
msgstr "参照"

#: assets/firmware_dialog.rml
msgid "Firmware folder"
msgstr "ファームウェアフォルダー"

#: assets/firmware_dialog.rml
msgid "A folder that holds the firmware's .nca files"
msgstr ".nca ファームウェア ファイルが含まれるフォルダー"

#: assets/firmware_dialog.rml
msgid "The game starts afterwards, and without it if you would rather not."
msgstr "その後、ゲームが開始されます。必要に応じてファームウェアなしでゲームが開始されます。"

#: assets/firmware_dialog.rml
msgid "The installed firmware stays in place until the new one is complete."
msgstr "インストールされたファームウェアは、新しいファームウェアの準備ができるまでそのまま残ります。"

#: assets/firmware_dialog.rml
msgid "Replace the installed firmware?"
msgstr "インストールされているファームウェアを交換しますか?"

#: assets/firmware_dialog.rml
msgid "Start without it"
msgstr "ファームウェアなしでブートする"

#: assets/firmware_dialog.rml
msgid "Keep the installed one"
msgstr "インストールされているバージョンを維持する"

#: assets/firmware_dialog.rml
msgid "Replace"
msgstr "交換"

#: assets/firmware_dialog.rml
msgid "Choose another source"
msgstr "別のソースを選択してください"

#: assets/general_dialog.rml
msgid "Display"
msgstr "ディスプレイ"

#: assets/general_dialog.rml
#: views/advanced_dialog.cpp
#: views/settings_context.cpp
msgid "Graphics device"
msgstr "グラフィックス デバイス"

#: assets/general_dialog.rml
msgid "Console mode"
msgstr "コンソールモード"

#: assets/general_dialog.rml
msgid "On the television, or in the hands."
msgstr "テレビでも、手元でも。"

#: assets/general_dialog.rml
msgid "As on the television: games draw up to 1080p."
msgstr "テレビと同様に、ゲームは最大 1080p で表示されます。"

#: assets/general_dialog.rml
#: views/main_window.cpp
#: views/settings_context.cpp
msgid "TV"
msgstr "TV"

#: assets/general_dialog.rml
msgid "As on the console's own screen: games draw 720p, which asks less of the computer."
msgstr "コンソール画面と同様: ゲームは 720p で表示されるため、コンピューターへの負担が少なくなります。"

#: assets/general_dialog.rml
#: views/controller_dialog.cpp
#: views/main_window.cpp
msgid "Handheld"
msgstr "携帯"

#: assets/general_dialog.rml
msgid "Resolution"
msgstr "解像度"

#: assets/general_dialog.rml
msgid "Window filter"
msgstr "拡大縮小フィルター"

#: assets/general_dialog.rml
msgid "How the picture is fitted to the window."
msgstr "画像がウィンドウにどのようにフィットするか。"

#: assets/general_dialog.rml
#: views/main_window.cpp
msgid "Sharpness of the FSR filter"
msgstr "FSRフィルターのシャープネス"

#: assets/general_dialog.rml
msgid "Aspect ratio"
msgstr "アスペクト比"

#: assets/general_dialog.rml
msgid "The shape of the picture in the window."
msgstr "ウィンドウ内の画像の比率。"

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Vertical sync"
msgstr "垂直同期"

#: assets/general_dialog.rml
msgid "Whole pictures only: no tearing."
msgstr "ティアリングのない完全な画像。"

#: assets/general_dialog.rml
msgid "Profile"
msgstr "プロフィール"

#: assets/general_dialog.rml
msgid "Who plays, with saves of their own."
msgstr "プレイヤーと、そのプレイヤー専用のセーブデータ。"

#: assets/general_dialog.rml
msgid "Add players, and change their names and pictures"
msgstr "プレイヤーを追加し、名前と画像を変更"

#: assets/general_dialog.rml
msgid "Manage"
msgstr "管理"

#: assets/general_dialog.rml
msgid "Language"
msgstr "言語"

#: assets/general_dialog.rml
msgid "Console language"
msgstr "コンソール言語"

#: assets/general_dialog.rml
msgid "The language games are shown in."
msgstr "ゲームが表示される言語。"

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Region"
msgstr "地域"

#: assets/general_dialog.rml
msgid "On, the region is the one chosen here. Off, it follows the console language."
msgstr "有効にした場合、リージョンはここで選択したリージョンになります。無効にすると、コンソール言語に従います。"

#: assets/general_dialog.rml
msgid "Interface language"
