#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
#: assets/directories_dialog.rml
#: assets/general_dialog.rml
#: assets/profiles_dialog.rml
msgid "Advanced"
msgstr "Avanzado"

#: assets/advanced_dialog.rml
msgid "Graphics"
msgstr "Gráficos"

#: assets/advanced_dialog.rml
msgid "System"
msgstr "Sistema"

#: assets/advanced_dialog.rml
msgid "Application"
msgstr "Aplicación"

#: assets/advanced_dialog.rml
msgid "Shortcuts"
msgstr "Atajos"

#: assets/advanced_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops."
msgstr "Hay un juego en ejecución: las opciones atenuadas no se pueden cambiar hasta que se detenga."

#: assets/advanced_dialog.rml
msgid "Picture"
msgstr "Imagen"

#: assets/advanced_dialog.rml
msgid "Anti-aliasing"
msgstr "Suavizado de bordes"

#: assets/advanced_dialog.rml
msgid "Smooths jagged edges."
msgstr "Suaviza los bordes dentados."

#: assets/advanced_dialog.rml
msgid "Anisotropic filtering"
msgstr "Filtrado anisotrópico"

#: assets/advanced_dialog.rml
msgid "Keeps textures sharp seen at a slant."
msgstr "Mantiene nítidas las texturas vistas en ángulo."

#: assets/advanced_dialog.rml
msgid "Accuracy"
msgstr "Precisión"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Accuracy level"
msgstr "Nivel de precisión"

#: assets/advanced_dialog.rml
msgid "How closely the graphics chip is imitated."
msgstr "La fidelidad con la que se emula el chip gráfico."

#: assets/advanced_dialog.rml
msgid "Memory reads"
msgstr "Lecturas de memoria"

#: assets/advanced_dialog.rml
msgid "How carefully the chip reads what games write."
msgstr "Con qué rigor lee el chip los datos que escriben los juegos."

#: assets/advanced_dialog.rml
msgid "Command synchronization"
msgstr "Sincronización de comandos"

#: assets/advanced_dialog.rml
msgid "Keeps the order games give their commands in."
msgstr "Respeta el orden en que los juegos envían sus comandos."

#: assets/advanced_dialog.rml
msgid "Slower, and steadier. Off, some games show faults, hang or crash."
msgstr "Más lento y más estable. Sin esta opción, algunos juegos muestran fallos, se bloquean o se cierran."

#: assets/advanced_dialog.rml
msgid "Reactive flushing"
msgstr "Vaciado reactivo"

#: assets/advanced_dialog.rml
msgid "Brings memory up to date when it is read."
msgstr "Actualiza la memoria cuando se lee."

#: assets/advanced_dialog.rml
msgid "More exact than guessing ahead when it will be read."
msgstr "Más preciso que anticipar cuándo se leerá."

#: assets/advanced_dialog.rml
msgid "Barrier feedback loops"
msgstr "Bucles de retroalimentación de barrera"

#: assets/advanced_dialog.rml
msgid "Draws transparent things right in some games."
msgstr "Dibuja correctamente los elementos transparentes en algunos juegos."

#: assets/advanced_dialog.rml
msgid "Fast GPU time"
msgstr "Tiempo de GPU rápido"

#: assets/advanced_dialog.rml
msgid "Most games then draw their highest resolution."
msgstr "La mayoría de los juegos usan entonces su resolución máxima."

#: assets/advanced_dialog.rml
msgid "Games that lower their resolution when the chip is slow are told it is fast."
msgstr "Indica que el chip es rápido a los juegos que reducen su resolución cuando es lento."

#: assets/advanced_dialog.rml
msgid "Videos at their own speed"
msgstr "Vídeos a su velocidad normal"

#: assets/advanced_dialog.rml
msgid "Even when the speed is not limited."
msgstr "Incluso cuando la velocidad no está limitada."

#: assets/advanced_dialog.rml
msgid "Textures and video"
msgstr "Texturas y vídeo"

#: assets/advanced_dialog.rml
msgid "ASTC decoding"
msgstr "Decodificación ASTC"

#: assets/advanced_dialog.rml
msgid "What decodes the textures of this kind."
msgstr "Qué decodifica las texturas de este tipo."

#: assets/advanced_dialog.rml
msgid "ASTC recompression"
msgstr "Recompresión ASTC"

#: assets/advanced_dialog.rml
msgid "Less graphics memory, for a lesser picture."
msgstr "Menos memoria gráfica, a costa de la calidad de imagen."

#: assets/advanced_dialog.rml
msgid "Graphics memory"
msgstr "Memoria gráfica"

#: assets/advanced_dialog.rml
msgid "How much of it games may take."
msgstr "La cantidad que pueden usar los juegos."

#: assets/advanced_dialog.rml
msgid "Video decoding"
msgstr "Decodificación de vídeo"

#: assets/advanced_dialog.rml
msgid "What decodes the videos of games."
msgstr "Qué decodifica los vídeos de los juegos."

#: assets/advanced_dialog.rml
msgid "Shaders"
msgstr "Sombreadores"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Keep shaders on the disk"
msgstr "Guardar los sombreadores en disco"

#: assets/advanced_dialog.rml
msgid "Games stutter less from their second start."
msgstr "Los juegos sufren menos tirones a partir del segundo inicio."

#: assets/advanced_dialog.rml
msgid "Off only to look for a fault."
msgstr "Desactívalo solo para investigar un fallo."

#: assets/advanced_dialog.rml
msgid "Driver pipeline cache"
msgstr "Caché de pipelines del controlador"

#: assets/advanced_dialog.rml
msgid "Shaders load faster with some drivers."
msgstr "Los sombreadores se cargan más rápido con algunos controladores."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Build shaders in the background"
msgstr "Compilar sombreadores en segundo plano"

#: assets/advanced_dialog.rml
msgid "Less stutter; things can show late. A hack."
msgstr "Menos tirones; algunos elementos pueden aparecer tarde. Es un truco de optimización."

#: assets/advanced_dialog.rml
msgid "Performance"
msgstr "Rendimiento"

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Graphics on their own thread"
msgstr "Gráficos en un hilo dedicado"

#: assets/advanced_dialog.rml
msgid "Should stay on."
msgstr "Conviene dejarlo activado."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Presentation on its own thread"
msgstr "Presentación en un hilo dedicado"

#: assets/advanced_dialog.rml
msgid "A little faster on some computers."
msgstr "Algo más rápido en algunos equipos."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "Keep the graphics device busy"
msgstr "Mantener ocupado el dispositivo gráfico"

#: assets/advanced_dialog.rml
msgid "So that it does not slow its clock. Uses more power."
msgstr "Evita que reduzca su frecuencia. Consume más energía."

#: assets/advanced_dialog.rml
msgid "Processor and memory"
msgstr "Procesador y memoria"

#: assets/advanced_dialog.rml
msgid "Processor engine"
msgstr "Motor del procesador"

#: assets/advanced_dialog.rml
msgid "How the game's code is run."
msgstr "Cómo se ejecuta el código del juego."

#: assets/advanced_dialog.rml
msgid "Processor accuracy"
msgstr "Precisión del procesador"

#: assets/advanced_dialog.rml
msgid "For the engine that translates the code."
msgstr "Para el motor que traduce el código."

#: assets/advanced_dialog.rml
msgid "Console memory"
msgstr "Memoria de la consola"

#: assets/advanced_dialog.rml
msgid "More than the console has: for heavy mods."
msgstr "Más que en la consola: para mods exigentes."

#: assets/advanced_dialog.rml
msgid "Multicore"
msgstr "Multinúcleo"

#: assets/advanced_dialog.rml
msgid "The cores of the console on as many threads."
msgstr "Los núcleos de la consola en otros tantos hilos."

#: assets/advanced_dialog.rml
msgid "Off, games run on one thread: much slower, to look for a fault."
msgstr "Si se desactiva, los juegos usan un solo hilo: mucho más lento, para investigar fallos."

#: assets/advanced_dialog.rml
#: views/settings_context.cpp
msgid "CPU and system in step"
msgstr "Sincronizar CPU y sistema"

#: assets/advanced_dialog.rml
msgid "Keeps the processor and the system's answers in order."
msgstr "Respeta el orden entre el procesador y las respuestas del sistema."

#: assets/advanced_dialog.rml
msgid "Needs multicore."
msgstr "Requiere el modo multinúcleo."

#: assets/advanced_dialog.rml
msgid "Emulation"
msgstr "Emulación"

#: assets/advanced_dialog.rml
#: views/hotkeys.h
#: views/settings_context.cpp
msgid "Limit speed"
msgstr "Limitar velocidad"

#: assets/advanced_dialog.rml
msgid "Off: as fast as the computer can."
msgstr "Desactivado: tan rápido como permita el equipo."

#: assets/advanced_dialog.rml
msgid "On, games run at the speed chosen: 100% is the speed of the console."
msgstr "Si está activado, los juegos se ejecutan a la velocidad elegida: el 100 % es la velocidad de la consola."

#: assets/advanced_dialog.rml
#: assets/general_dialog.rml
msgid "Audio"
msgstr "Audio"

#: assets/advanced_dialog.rml
msgid "Output engine"
msgstr "Motor de salida"

#: assets/advanced_dialog.rml
msgid "What plays the sound on this computer."
msgstr "Qué reproduce el sonido en este equipo."

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Input device"
msgstr "Dispositivo de entrada"

#: assets/advanced_dialog.rml
msgid "The microphone games listen to."
msgstr "El micrófono que usan los juegos."

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Vibration"
msgstr "Vibración"

#: assets/advanced_dialog.rml
msgid "For every player. Each has a switch of their own."
msgstr "Para todos los jugadores. Cada uno tiene también su propio interruptor."

#: assets/advanced_dialog.rml
msgid "Accurate vibration"
msgstr "Vibración precisa"

#: assets/advanced_dialog.rml
msgid "Every change is sent: some controllers lag."
msgstr "Se envía cada cambio: algunos mandos responden con retraso."

#: assets/advanced_dialog.rml
msgid "Behaviour"
msgstr "Comportamiento"

#: assets/advanced_dialog.rml
#: views/main_window.cpp
msgid "Start games in fullscreen"
msgstr "Iniciar juegos en pantalla completa"

#: assets/advanced_dialog.rml
#: views/main_window.cpp
msgid "Start games with UI hidden"
msgstr "Iniciar juegos con la interfaz oculta"

#: assets/advanced_dialog.rml
msgid "Confirm before stopping"
msgstr "Confirmar antes de detener"

#: assets/advanced_dialog.rml
msgid "Asks before a running game is stopped."
msgstr "Pide confirmación antes de detener un juego en ejecución."

#: assets/advanced_dialog.rml
msgid "Discord presence"
msgstr "Presencia en Discord"

#: assets/advanced_dialog.rml
msgid "Shows what you play in Discord when it runs."
msgstr "Muestra a qué juegas en Discord cuando está abierto."

#: assets/advanced_dialog.rml
msgid "Log"
msgstr "Registro"

#: assets/advanced_dialog.rml
msgid "Show the log console"
msgstr "Mostrar la consola del registro"

#: assets/advanced_dialog.rml
msgid "The log is also written as it comes."
msgstr "El registro también se muestra a medida que se genera."

#: assets/advanced_dialog.rml
msgid "Log filter"
msgstr "Filtro del registro"

#: assets/advanced_dialog.rml
msgid "What is written, as class:level."
msgstr "Qué se registra, en formato clase:nivel."

#: assets/advanced_dialog.rml
msgid "Click a shortcut, then press its keys. A click elsewhere keeps it as it is."
msgstr "Haz clic en un atajo y pulsa sus teclas. Un clic en otro lugar lo deja como está."

#: assets/advanced_dialog.rml
msgid "In game"
msgstr "En el juego"

#: assets/advanced_dialog.rml
#: assets/controller_dialog.rml
msgid "Restore defaults"
msgstr "Restablecer valores predeterminados"

#: assets/advanced_dialog.rml
msgid "Inherit all settings"
msgstr "Heredar todos los ajustes"

#: assets/advanced_dialog.rml
msgid "Restore the defaults of all the tabs?"
msgstr "¿Restablecer los valores predeterminados de todas las pestañas?"

#: assets/advanced_dialog.rml
msgid "Remove your overrides and re-enable NXEmu settings for this game?"
msgstr "¿Eliminar tus ajustes personalizados y reactivar los ajustes de NXEmu para este juego?"

#: assets/advanced_dialog.rml
#: assets/profiles_dialog.rml
msgid "Keep"
msgstr "Conservar"

#: assets/advanced_dialog.rml
msgid "Restore"
msgstr "Restablecer"

#: assets/advanced_dialog.rml
#: assets/directories_dialog.rml
#: assets/firmware_dialog.rml
#: assets/general_dialog.rml
#: assets/main_window.rml
#: assets/profiles_dialog.rml
#: views/firmware_dialog.cpp
msgid "Close"
msgstr "Cerrar"

#: assets/controller_dialog.rml
msgid "On, games see this player's controller as plugged into the console."
msgstr "Si está activado, los juegos ven el mando de este jugador conectado a la consola."

#: assets/controller_dialog.rml
msgid "Connected"
msgstr "Conectado"

#: assets/controller_dialog.rml
msgid "Controller"
msgstr "Mando"

#: assets/controller_dialog.rml
#: views/controller_dialog.cpp
msgid "Left stick"
msgstr "Palanca izquierda"

#: assets/controller_dialog.rml
msgid "Deadzone"
msgstr "Zona muerta"

#: assets/controller_dialog.rml
msgid "Range"
msgstr "Recorrido"

#: assets/controller_dialog.rml
msgid "Modifier range"
msgstr "Recorrido con modificador"

#: assets/controller_dialog.rml
msgid "D-pad"
msgstr "Cruceta"

#: assets/controller_dialog.rml
msgid "On, the controller shakes when games ask it to."
msgstr "Si está activado, el mando vibra cuando lo pide el juego."

#: assets/controller_dialog.rml
msgid "Face buttons"
msgstr "Botones frontales"

#: assets/controller_dialog.rml
#: views/controller_dialog.cpp
msgid "Right stick"
msgstr "Palanca derecha"

#: assets/controller_dialog.rml
msgid "Asks for each control in turn"
msgstr "Solicita cada control por turnos"

#: assets/controller_dialog.rml
msgid "Bind all controls"
msgstr "Asignar todos los controles"

#: assets/controller_dialog.rml
msgid "Binds this player's controls as the input device suggests"
msgstr "Asigna los controles de este jugador según las sugerencias del dispositivo de entrada"

#: assets/controller_dialog.rml
#: assets/firmware_dialog.rml
msgid "Cancel"
msgstr "Cancelar"

#: assets/controller_dialog.rml
msgid "Save"
msgstr "Guardar"

#: assets/directories_dialog.rml
msgid "The folders NXEmu looks for games in. The folders inside them are not searched."
msgstr "Las carpetas en las que NXEmu busca juegos. No se buscan juegos en sus subcarpetas."

#: assets/directories_dialog.rml
msgid "Add a directory"
msgstr "Añadir una carpeta"

#: assets/directories_dialog.rml
msgid "The game directories cannot change while a game is running."
msgstr "Las carpetas de juegos no se pueden cambiar mientras se ejecuta un juego."

#: assets/firmware_dialog.rml
msgid "Install firmware"
msgstr "Instalar firmware"

#: assets/firmware_dialog.rml
msgid "Source"
msgstr "Origen"

#: assets/firmware_dialog.rml
msgid "Install"
msgstr "Instalar"

#: assets/firmware_dialog.rml
msgid "Finish"
msgstr "Finalizar"

#: assets/firmware_dialog.rml
msgid "Where is the firmware?"
msgstr "¿Dónde está el firmware?"

#: assets/firmware_dialog.rml
msgid "Most games need the console's firmware. Choose the package to install it from, or drop it on this window."
msgstr "La mayoría de los juegos necesitan el firmware de la consola. Elige el paquete desde el que instalarlo o arrástralo a esta ventana."

#: assets/firmware_dialog.rml
msgid "Firmware file"
msgstr "Archivo de firmware"

#: assets/firmware_dialog.rml
msgid "A .zip archive, or a .dxci game card image that carries an update"
msgstr "Un archivo .zip o una imagen de tarjeta de juego .dxci que incluya una actualización"

#: assets/firmware_dialog.rml
msgid "Browse"
msgstr "Examinar"

#: assets/firmware_dialog.rml
msgid "Firmware folder"
msgstr "Carpeta del firmware"

#: assets/firmware_dialog.rml
msgid "A folder that holds the firmware's .nca files"
msgstr "Una carpeta que contenga los archivos .nca del firmware"

#: assets/firmware_dialog.rml
msgid "The game starts afterwards, and without it if you would rather not."
msgstr "El juego se iniciará después, o sin firmware si lo prefieres."

#: assets/firmware_dialog.rml
msgid "The installed firmware stays in place until the new one is complete."
msgstr "El firmware instalado se conserva hasta que el nuevo esté listo."

#: assets/firmware_dialog.rml
msgid "Replace the installed firmware?"
msgstr "¿Reemplazar el firmware instalado?"

#: assets/firmware_dialog.rml
msgid "Start without it"
msgstr "Iniciar sin firmware"

#: assets/firmware_dialog.rml
msgid "Keep the installed one"
msgstr "Conservar el instalado"

#: assets/firmware_dialog.rml
msgid "Replace"
msgstr "Reemplazar"

#: assets/firmware_dialog.rml
msgid "Choose another source"
msgstr "Elegir otro origen"

#: assets/general_dialog.rml
msgid "Display"
msgstr "Pantalla"

#: assets/general_dialog.rml
#: views/advanced_dialog.cpp
#: views/settings_context.cpp
msgid "Graphics device"
msgstr "Dispositivo gráfico"

#: assets/general_dialog.rml
msgid "Console mode"
msgstr "Modo de la consola"

#: assets/general_dialog.rml
msgid "On the television, or in the hands."
msgstr "En el televisor o en las manos."

#: assets/general_dialog.rml
msgid "As on the television: games draw up to 1080p."
msgstr "Como en el televisor: los juegos se dibujan hasta a 1080p."

#: assets/general_dialog.rml
#: views/main_window.cpp
#: views/settings_context.cpp
msgid "Docked"
msgstr "Docked"

#: assets/general_dialog.rml
msgid "As on the console's own screen: games draw 720p, which asks less of the computer."
msgstr "Como en la pantalla de la consola: los juegos se dibujan a 720p, lo que exige menos al equipo."

#: assets/general_dialog.rml
#: views/controller_dialog.cpp
#: views/main_window.cpp
msgid "Handheld"
msgstr "Portátil"

#: assets/general_dialog.rml
msgid "Resolution"
msgstr "Resolución"

#: assets/general_dialog.rml
msgid "Window filter"
msgstr "Filtro de escalado"

#: assets/general_dialog.rml
msgid "How the picture is fitted to the window."
msgstr "Cómo se adapta la imagen a la ventana."

#: assets/general_dialog.rml
#: views/main_window.cpp
msgid "Sharpness of the FSR filter"
msgstr "Nitidez del filtro FSR"

#: assets/general_dialog.rml
msgid "Aspect ratio"
msgstr "Relación de aspecto"

#: assets/general_dialog.rml
msgid "The shape of the picture in the window."
msgstr "Las proporciones de la imagen en la ventana."

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Vertical sync"
msgstr "Sincronización vertical"

#: assets/general_dialog.rml
msgid "Whole pictures only: no tearing."
msgstr "Solo imágenes completas, sin desgarros."

#: assets/general_dialog.rml
msgid "Profile"
msgstr "Perfil"

#: assets/general_dialog.rml
msgid "Who plays, with saves of their own."
msgstr "Quién juega, con sus propias partidas guardadas."

#: assets/general_dialog.rml
msgid "Add players, and change their names and pictures"
msgstr "Añadir jugadores y cambiar sus nombres e imágenes"

#: assets/general_dialog.rml
msgid "Manage"
msgstr "Gestionar"

#: assets/general_dialog.rml
msgid "Language"
msgstr "Idioma"

#: assets/general_dialog.rml
msgid "Console language"
msgstr "Idioma de la consola"

#: assets/general_dialog.rml
msgid "The language games are shown in."
msgstr "El idioma en el que se muestran los juegos."

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Region"
msgstr "Región"

#: assets/general_dialog.rml
msgid "On, the region is the one chosen here. Off, it follows the console language."
msgstr "Si está activado, se usa la región elegida aquí. Si no, se usa la correspondiente al idioma de la consola."

#: assets/general_dialog.rml
msgid "Interface language"
msgstr "Idioma de la interfaz"

#: assets/general_dialog.rml
msgid "On, the interface language is chosen here. Off, it follows the console language."
msgstr "Si está activado, el idioma de la interfaz se elige aquí. Si no, sigue el idioma de la consola."

#: assets/general_dialog.rml
msgid "Output device"
msgstr "Dispositivo de salida"

#: assets/general_dialog.rml
msgid "Where the sound of games is played."
msgstr "Dónde se reproduce el sonido de los juegos."

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Output mode"
msgstr "Modo de salida"

#: assets/general_dialog.rml
msgid "Surround needs speakers that play it."
msgstr "El sonido envolvente requiere altavoces compatibles."

#: assets/general_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops, and the languages and the audio output are read when a game starts."
msgstr "Hay un juego en ejecución: las opciones atenuadas no se pueden cambiar hasta que se detenga. Los idiomas y la salida de audio se leen al iniciar un juego."

#: assets/main_window.rml
#: views/main_window.cpp
msgid "Pause emulation (F2)"
msgstr "Pausar emulación (F2)"

#: assets/main_window.rml
msgid "Stop emulation (F5)"
msgstr "Detener emulación (F5)"

#: assets/main_window.rml
msgid "Minimise"
msgstr "Minimizar"

#: assets/main_window.rml
msgid "Maximise or restore"
msgstr "Maximizar o restaurar"

#: assets/main_window.rml
msgid "Library"
msgstr "Biblioteca"

#: assets/main_window.rml
msgid "Search games..."
msgstr "Buscar juegos..."

#: assets/main_window.rml
msgid "Sort games"
msgstr "Ordenar juegos"

#: assets/main_window.rml
msgid "Icon size"
msgstr "Tamaño de iconos"

#: assets/main_window.rml
msgid "Title"
msgstr "Título"

#: assets/main_window.rml
msgid "Card information"
msgstr "Información de la tarjeta"

#: assets/main_window.rml
#: views/main_window.cpp
msgid "Play time"
msgstr "Tiempo de juego"

#: assets/main_window.rml
msgid "List view"
msgstr "Vista de lista"

#: assets/main_window.rml
msgid "Shows or hides the details of the selected game"
msgstr "Muestra u oculta los detalles del juego seleccionado"

#: assets/main_window.rml
msgid "Details"
msgstr "Detalles"

#: assets/main_window.rml
msgid "Cover"
msgstr "Carátula"

#: assets/main_window.rml
msgid "Game"
msgstr "Juego"

#: assets/main_window.rml
#: views/main_window.cpp
msgid "Publisher"
msgstr "Editor"

#: assets/main_window.rml
#: views/main_window.cpp
msgid "Version"
msgstr "Versión"

#: assets/main_window.rml
