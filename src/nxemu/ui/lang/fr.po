msgid "Close"
msgstr "Fermer"

#: assets/controller_dialog.rml
msgid "On, games see this player's controller as plugged into the console."
msgstr "Activé, le jeu voit la manette de ce joueur comme connectée à la console."

#: assets/controller_dialog.rml
msgid "Connected"
msgstr "Connecté"

#: assets/controller_dialog.rml
msgid "Controller"
msgstr "Manette"

#: assets/controller_dialog.rml
#: views/controller_dialog.cpp
msgid "Left stick"
msgstr "Stick gauche"

#: assets/controller_dialog.rml
msgid "Deadzone"
msgstr "Zone morte"

#: assets/controller_dialog.rml
msgid "Range"
msgstr "Amplitude"

#: assets/controller_dialog.rml
msgid "Modifier range"
msgstr "Amplitude avec modificateur"

#: assets/controller_dialog.rml
msgid "D-pad"
msgstr "Croix directionnelle"

#: assets/controller_dialog.rml
msgid "On, the controller shakes when games ask it to."
msgstr "Activé, la manette vibre lorsque le jeu le demande."

#: assets/controller_dialog.rml
msgid "Face buttons"
msgstr "Boutons d'action"

#: assets/controller_dialog.rml
#: views/controller_dialog.cpp
msgid "Right stick"
msgstr "Stick droit"

#: assets/controller_dialog.rml
msgid "Asks for each control in turn"
msgstr "Demande chaque commande à tour de rôle"

#: assets/controller_dialog.rml
msgid "Bind all controls"
msgstr "Assigner toutes les commandes"

#: assets/controller_dialog.rml
msgid "Binds this player's controls as the input device suggests"
msgstr "Assigne les commandes de ce joueur selon les suggestions du périphérique d'entrée"

#: assets/controller_dialog.rml
#: assets/firmware_dialog.rml
msgid "Cancel"
msgstr "Annuler"

#: assets/controller_dialog.rml
msgid "Save"
msgstr "Enregistrer"

#: assets/directories_dialog.rml
msgid "The folders NXEmu looks for games in. The folders inside them are not searched."
msgstr "Les dossiers dans lesquels NXEmu recherche les jeux. Leurs sous-dossiers ne sont pas parcourus."

#: assets/directories_dialog.rml
msgid "Add a directory"
msgstr "Ajouter un dossier"

#: assets/directories_dialog.rml
msgid "The game directories cannot change while a game is running."
msgstr "Les dossiers de jeux ne peuvent pas être modifiés pendant qu'un jeu est en cours."

#: assets/firmware_dialog.rml
msgid "Install firmware"
msgstr "Installer un firmware"

#: assets/firmware_dialog.rml
msgid "Source"
msgstr "Source"

#: assets/firmware_dialog.rml
msgid "Install"
msgstr "Installer"

#: assets/firmware_dialog.rml
msgid "Finish"
msgstr "Terminer"

#: assets/firmware_dialog.rml
msgid "Where is the firmware?"
msgstr "Où se trouve le firmware ?"

#: assets/firmware_dialog.rml
msgid "Most games need the console's firmware. Choose the package to install it from, or drop it on this window."
msgstr "La plupart des jeux nécessitent le firmware de la console. Choisissez le fichier à installer ou déposez-le dans cette fenêtre."

#: assets/firmware_dialog.rml
msgid "Firmware file"
msgstr "Fichier du firmware"

#: assets/firmware_dialog.rml
msgid "A .zip archive, or a .dxci game card image that carries an update"
msgstr "Une archive .zip ou une image de carte de jeu .dxci contenant une mise à jour"

#: assets/firmware_dialog.rml
msgid "Browse"
msgstr "Parcourir"

#: assets/firmware_dialog.rml
msgid "Firmware folder"
msgstr "Dossier du firmware"

#: assets/firmware_dialog.rml
msgid "A folder that holds the firmware's .nca files"
msgstr "Un dossier contenant les fichiers .nca du firmware"

#: assets/firmware_dialog.rml
msgid "The game starts afterwards, and without it if you would rather not."
msgstr "Le jeu démarrera ensuite, ou sans firmware si vous préférez."

#: assets/firmware_dialog.rml
msgid "The installed firmware stays in place until the new one is complete."
msgstr "Le firmware installé reste en place jusqu'à ce que le nouveau soit prêt."

#: assets/firmware_dialog.rml
msgid "Replace the installed firmware?"
msgstr "Remplacer le firmware installé ?"

#: assets/firmware_dialog.rml
msgid "Start without it"
msgstr "Démarrer sans firmware"

#: assets/firmware_dialog.rml
msgid "Keep the installed one"
msgstr "Conserver la version installée"

#: assets/firmware_dialog.rml
msgid "Replace"
msgstr "Remplacer"

#: assets/firmware_dialog.rml
msgid "Choose another source"
msgstr "Choisir une autre source"

#: assets/general_dialog.rml
msgid "Display"
msgstr "Affichage"

#: assets/general_dialog.rml
#: views/advanced_dialog.cpp
#: views/settings_context.cpp
msgid "Graphics device"
msgstr "Périphérique graphique"

#: assets/general_dialog.rml
msgid "Console mode"
msgstr "Mode de la console"

#: assets/general_dialog.rml
msgid "On the television, or in the hands."
msgstr "Sur le téléviseur ou entre les mains."

#: assets/general_dialog.rml
msgid "As on the television: games draw up to 1080p."
msgstr "Comme sur le téléviseur : les jeux s'affichent jusqu'en 1080p."

#: assets/general_dialog.rml
#: views/main_window.cpp
#: views/settings_context.cpp
msgid "TV"
msgstr "TV"

#: assets/general_dialog.rml
msgid "As on the console's own screen: games draw 720p, which asks less of the computer."
msgstr "Comme sur l'écran de la console : les jeux s'affichent en 720p, ce qui sollicite moins l'ordinateur."

#: assets/general_dialog.rml
#: views/controller_dialog.cpp
#: views/main_window.cpp
msgid "Handheld"
msgstr "Portable"

#: assets/general_dialog.rml
msgid "Resolution"
msgstr "Résolution"

#: assets/general_dialog.rml
msgid "Window filter"
msgstr "Filtre de mise à l'échelle"

#: assets/general_dialog.rml
msgid "How the picture is fitted to the window."
msgstr "La façon dont l'image est adaptée à la fenêtre."

#: assets/general_dialog.rml
#: views/main_window.cpp
msgid "Sharpness of the FSR filter"
msgstr "Netteté du filtre FSR"

#: assets/general_dialog.rml
msgid "Aspect ratio"
msgstr "Rapport d'image"

#: assets/general_dialog.rml
msgid "The shape of the picture in the window."
msgstr "Les proportions de l'image dans la fenêtre."

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Vertical sync"
msgstr "Synchronisation verticale"

#: assets/general_dialog.rml
msgid "Whole pictures only: no tearing."
msgstr "Des images entières, sans déchirement."

#: assets/general_dialog.rml
msgid "Profile"
msgstr "Profil"

#: assets/general_dialog.rml
msgid "Who plays, with saves of their own."
msgstr "Le joueur, avec ses propres sauvegardes."

#: assets/general_dialog.rml
msgid "Add players, and change their names and pictures"
msgstr "Ajouter des joueurs et modifier leur nom et leur image"

#: assets/general_dialog.rml
msgid "Manage"
msgstr "Gérer"

#: assets/general_dialog.rml
msgid "Language"
msgstr "Langue"

#: assets/general_dialog.rml
msgid "Console language"
msgstr "Langue de la console"

#: assets/general_dialog.rml
msgid "The language games are shown in."
msgstr "La langue dans laquelle les jeux s'affichent."

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Region"
msgstr "Région"

#: assets/general_dialog.rml
msgid "On, the region is the one chosen here. Off, it follows the console language."
msgstr "Activé, la région est celle choisie ici. Désactivé, elle suit la langue de la console."

#: assets/general_dialog.rml
msgid "Interface language"
msgstr "Langue de l'interface"

#: assets/general_dialog.rml
msgid "On, the interface language is chosen here. Off, it follows the console language."
msgstr "Activé, la langue de l'interface est choisie ici. Désactivé, elle suit la langue de la console."

#: assets/general_dialog.rml
msgid "Output device"
msgstr "Périphérique de sortie"

#: assets/general_dialog.rml
msgid "Where the sound of games is played."
msgstr "Où le son des jeux est diffusé."

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Output mode"
msgstr "Mode de sortie"

#: assets/general_dialog.rml
msgid "Surround needs speakers that play it."
msgstr "Le son surround nécessite des enceintes compatibles."

#: assets/general_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops, and the languages and the audio output are read when a game starts."
msgstr "Un jeu est en cours : les options grisées ne peuvent pas être modifiées avant son arrêt. Les langues et la sortie audio sont prises en compte au lancement d'un jeu."

