msgid "Game"
msgstr "Jogo"

#: assets/main_window.rml
#: views/main_window.cpp
msgid "Publisher"
msgstr "Editor"

#: assets/main_window.rml
#: views/main_window.cpp
msgid "Version"
msgstr "Versão"

#: assets/main_window.rml
#: views/main_window.cpp
msgid "Last played"
msgstr "Última parte"

#: assets/main_window.rml
