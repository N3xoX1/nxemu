msgid "Play time"
msgstr "Tempo de reprodução"

#: assets/main_window.rml
msgid "List view"
msgstr "Visualização de lista"

#: assets/main_window.rml
msgid "Shows or hides the details of the selected game"
msgstr "Mostrar ou ocultar os detalhes do jogo selecionado"

#: assets/main_window.rml
msgid "Details"
msgstr "Detalhes"

#: assets/main_window.rml
msgid "Cover"
msgstr "Capa"

