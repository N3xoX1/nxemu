#: assets/profiles_dialog.rml
#: views/firmware_dialog.cpp
msgid "Close"
msgstr "Fechar"

#: assets/controller_dialog.rml
msgid "On, games see this player's controller as plugged into the console."
msgstr "Activado, o jogo vê o comando deste jogador como ligado à consola."

#: assets/controller_dialog.rml
msgid "Connected"
msgstr "Conectado"

#: assets/controller_dialog.rml
msgid "Controller"
msgstr "Comando"

#: assets/controller_dialog.rml
#: views/controller_dialog.cpp
msgid "Left stick"
msgstr "Comando esquerdo"

#: assets/controller_dialog.rml
msgid "Deadzone"
msgstr "Zona morta"

#: assets/controller_dialog.rml
msgid "Range"
msgstr "Amplitude"

#: assets/controller_dialog.rml
msgid "Modifier range"
msgstr "Amplitude com modificador"

#: assets/controller_dialog.rml
msgid "D-pad"
msgstr "Teclado direcional"

#: assets/controller_dialog.rml
msgid "On, the controller shakes when games ask it to."
msgstr "Activado, o comando vibra quando o jogo o solicita."

#: assets/controller_dialog.rml
msgid "Face buttons"
msgstr "Botões de ação"

#: assets/controller_dialog.rml
#: views/controller_dialog.cpp
msgid "Right stick"
msgstr "Comando direito"

#: assets/controller_dialog.rml
msgid "Asks for each control in turn"
msgstr "Solicite cada comando de cada vez"

#: assets/controller_dialog.rml
msgid "Bind all controls"
msgstr "Atribuir todos os controlos"

#: assets/controller_dialog.rml
msgid "Binds this player's controls as the input device suggests"
msgstr "Atribui os controlos deste jogador conforme sugerido pelo dispositivo de entrada"

#: assets/controller_dialog.rml
#: assets/firmware_dialog.rml
msgid "Cancel"
msgstr "Cancelar"

#: assets/controller_dialog.rml
msgid "Save"
msgstr "Guardar"

#: assets/directories_dialog.rml
msgid "The folders NXEmu looks for games in. The folders inside them are not searched."
msgstr "As pastas em que o NXEmu procura jogos. As suas subpastas não são navegadas."

#: assets/directories_dialog.rml
msgid "Add a directory"
msgstr "Adicionar pasta"

#: assets/directories_dialog.rml
msgid "The game directories cannot change while a game is running."
msgstr "As pastas do jogo não podem ser editadas enquanto um jogo está em curso."

#: assets/firmware_dialog.rml
msgid "Install firmware"
msgstr "Instalar firmware"

#: assets/firmware_dialog.rml
msgid "Source"
msgstr "Fonte"

#: assets/firmware_dialog.rml
msgid "Install"
msgstr "Instalar"

#: assets/firmware_dialog.rml
msgid "Finish"
msgstr "Concluir"

#: assets/firmware_dialog.rml
msgid "Where is the firmware?"
msgstr "Onde está o firmware?"

#: assets/firmware_dialog.rml
msgid "Most games need the console's firmware. Choose the package to install it from, or drop it on this window."
msgstr "A maioria dos jogos requer firmware de consola. Escolha o ficheiro para instalar ou solte-o nesta janela."

#: assets/firmware_dialog.rml
msgid "Firmware file"
msgstr "Ficheiro de firmware"

#: assets/firmware_dialog.rml
msgid "A .zip archive, or a .dxci game card image that carries an update"
msgstr "Um ficheiro .zip ou imagem de cartão de jogo .dxci contendo uma atualização"

#: assets/firmware_dialog.rml
msgid "Browse"
msgstr "Navegar"

#: assets/firmware_dialog.rml
msgid "Firmware folder"
msgstr "Pasta de firmware"

#: assets/firmware_dialog.rml
msgid "A folder that holds the firmware's .nca files"
msgstr "Uma pasta que contém os ficheiros de firmware .nca"

#: assets/firmware_dialog.rml
msgid "The game starts afterwards, and without it if you would rather not."
msgstr "O jogo será iniciado nessa altura, ou sem firmware se preferir."

#: assets/firmware_dialog.rml
msgid "The installed firmware stays in place until the new one is complete."
msgstr "O firmware instalado permanece no lugar até que o novo esteja pronto."

#: assets/firmware_dialog.rml
msgid "Replace the installed firmware?"
msgstr "Substituir firmware instalado?"

#: assets/firmware_dialog.rml
msgid "Start without it"
msgstr "Arranque sem firmware"

#: assets/firmware_dialog.rml
msgid "Keep the installed one"
msgstr "Manter versão instalada"

#: assets/firmware_dialog.rml
msgid "Replace"
msgstr "Substituir"

#: assets/firmware_dialog.rml
msgid "Choose another source"
msgstr "Escolha outra fonte"

#: assets/general_dialog.rml
msgid "Display"
msgstr "Exibição"

#: assets/general_dialog.rml
#: views/advanced_dialog.cpp
#: views/settings_context.cpp
msgid "Graphics device"
msgstr "Dispositivo gráfico"

#: assets/general_dialog.rml
msgid "Console mode"
msgstr "Modo consola"

#: assets/general_dialog.rml
msgid "On the television, or in the hands."
msgstr "Na TV ou nas suas mãos."

#: assets/general_dialog.rml
msgid "As on the television: games draw up to 1080p."
msgstr "Como na TV: os jogos são apresentados até 1080p."

#: assets/general_dialog.rml
#: views/main_window.cpp
#: views/settings_context.cpp
msgid "TV"
msgstr "TV"

#: assets/general_dialog.rml
msgid "As on the console's own screen: games draw 720p, which asks less of the computer."
msgstr "Tal como no ecrã da consola: os jogos são apresentados a 720p, o que sobrecarrega menos o computador."

#: assets/general_dialog.rml
#: views/controller_dialog.cpp
#: views/main_window.cpp
msgid "Handheld"
msgstr "Portátil"

#: assets/general_dialog.rml
msgid "Resolution"
msgstr "Resolução"

#: assets/general_dialog.rml
msgid "Window filter"
msgstr "Filtro de escala"

#: assets/general_dialog.rml
msgid "How the picture is fitted to the window."
msgstr "Como a imagem se ajusta à janela."

#: assets/general_dialog.rml
#: views/main_window.cpp
msgid "Sharpness of the FSR filter"
msgstr "Nitidez do filtro FSR"

#: assets/general_dialog.rml
msgid "Aspect ratio"
msgstr "Rácio de aspeto"

#: assets/general_dialog.rml
msgid "The shape of the picture in the window."
msgstr "As proporções da imagem na janela."

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Vertical sync"
msgstr "Sincronização vertical"

#: assets/general_dialog.rml
msgid "Whole pictures only: no tearing."
msgstr "Imagens completas, sem tearing."

#: assets/general_dialog.rml
msgid "Profile"
msgstr "Perfil"

#: assets/general_dialog.rml
msgid "Who plays, with saves of their own."
msgstr "O jogador, com os seus próprios dados de gravação."

#: assets/general_dialog.rml
msgid "Add players, and change their names and pictures"
msgstr "Adicionar jogadores e alterar os seus nomes e imagens"

#: assets/general_dialog.rml
msgid "Manage"
msgstr "Gerir"

#: assets/general_dialog.rml
msgid "Language"
msgstr "Idioma"

#: assets/general_dialog.rml
msgid "Console language"
msgstr "Idioma da consola"

#: assets/general_dialog.rml
msgid "The language games are shown in."
msgstr "O idioma em que os jogos são apresentados."

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Region"
msgstr "Região"

#: assets/general_dialog.rml
msgid "On, the region is the one chosen here. Off, it follows the console language."
msgstr "Quando activado, a região é a aqui escolhida. Desativado, segue o idioma da consola."

#: assets/general_dialog.rml
msgid "Interface language"
msgstr "Idioma da interface"

#: assets/general_dialog.rml
msgid "On, the interface language is chosen here. Off, it follows the console language."
msgstr "Quando ativado, o idioma da interface é escolhido aqui. Caso contrário, segue o idioma da consola."

#: assets/general_dialog.rml
msgid "Output device"
msgstr "Dispositivo de saída"

#: assets/general_dialog.rml
msgid "Where the sound of games is played."
msgstr "Onde é reproduzido o áudio do jogo."

#: assets/general_dialog.rml
#: views/settings_context.cpp
msgid "Output mode"
msgstr "Modo de saída"

#: assets/general_dialog.rml
msgid "Surround needs speakers that play it."
msgstr "O som surround requer colunas compatíveis."

#: assets/general_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops, and the languages and the audio output are read when a game starts."
msgstr "Está um jogo em execução: as opções a cinzento só podem ser alteradas depois de o parar. Os idiomas e a saída de áudio são lidos ao iniciar um jogo."

#: assets/main_window.rml
