#version 450
layout(local_size_x = 1) in;
layout(binding = 0, std430) readonly buffer SourceX { uint x_words[]; };
layout(binding = 1, std430) readonly buffer SourceYZ { uint yz_words[]; };
layout(binding = 2, std430) writeonly buffer Output { uint dimensions[3]; };
layout(location = 0) uniform uvec4 parameters;
layout(location = 1) uniform uint dynamic_mask;
void main() {
    uint x = (dynamic_mask & 1u) != 0u ? x_words[parameters.x] : parameters.z;
    uint yz = (dynamic_mask & 2u) != 0u ? yz_words[parameters.y] : parameters.w;
    dimensions[0] = x & 0x7fffffffu;
    dimensions[1] = yz & 0xffffu;
    dimensions[2] = yz >> 16u;
}
