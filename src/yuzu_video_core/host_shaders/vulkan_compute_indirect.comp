#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer SourceX { uint x_words[]; };
layout(set = 0, binding = 1, std430) readonly buffer SourceYZ { uint yz_words[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Output { uint dimensions[3]; };
layout(push_constant) uniform Parameters {
    uint x_offset;
    uint yz_offset;
    uint default_x;
    uint default_yz;
    uint dynamic_mask;
};
void main() {
    uint x = (dynamic_mask & 1u) != 0u ? x_words[x_offset] : default_x;
    uint yz = (dynamic_mask & 2u) != 0u ? yz_words[yz_offset] : default_yz;
    // Maxwell QMD has a 31-bit X and two packed 16-bit Y/Z fields.
    // VkDispatchIndirectCommand has three separate 32-bit fields.
    dimensions[0] = x & 0x7fffffffu;
    dimensions[1] = yz & 0xffffu;
    dimensions[2] = yz >> 16u;
}
