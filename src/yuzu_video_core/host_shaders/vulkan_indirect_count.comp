#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Arguments { uint args[]; };
layout(set = 0, binding = 1, std430) readonly buffer Count { uint counts[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Output { uint output_args[]; };
layout(push_constant) uniform Parameters {
    uint source_word;
    uint count_word;
    uint max_draws;
    uint stride_words;
};
void main() {
    uint draw = gl_GlobalInvocationID.x;
    if (draw >= max_draws) {
        return;
    }
    bool enabled = draw < min(counts[count_word], max_draws);
    for (uint word = 0; word < 5; ++word) {
        output_args[draw * 5 + word] = enabled ? args[source_word + draw * stride_words + word] : 0;
    }
}
