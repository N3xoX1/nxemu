# Packages the RmlUi frontend as a self-contained application bundle.
foreach(required BUNDLE EXECUTABLE LOADER CPU VIDEO OS MOLTENVK SDL ASSETS LANG_DIR UI_PACK CODESIGN INSTALL_NAME_TOOL OTOOL INFO_PLIST ICON SHORT_VERSION BUILD_VERSION MINIMUM_MACOS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing bundle input: ${required}")
    endif()
endforeach()
set(frameworks "${BUNDLE}/Contents/Frameworks")
set(resources "${BUNDLE}/Contents/Resources")
file(MAKE_DIRECTORY "${frameworks}" "${resources}")

get_filename_component(MACOSX_BUNDLE_EXECUTABLE_NAME "${EXECUTABLE}" NAME)
set(MACOSX_BUNDLE_SHORT_VERSION_STRING "${SHORT_VERSION}")
set(MACOSX_BUNDLE_BUNDLE_VERSION "${BUILD_VERSION}")
set(CMAKE_OSX_DEPLOYMENT_TARGET "${MINIMUM_MACOS}")
configure_file("${INFO_PLIST}" "${BUNDLE}/Contents/Info.plist")
file(COPY_FILE "${ICON}" "${resources}/nxemu.icns" ONLY_IF_DIFFERENT)
# The PE resource pack is data. Putting it in MacOS makes codesign treat it as code.
file(REMOVE "${BUNDLE}/Contents/MacOS/nxemu.lang")
file(COPY_FILE "${UI_PACK}" "${resources}/nxemu.lang" ONLY_IF_DIFFERENT)

file(REMOVE_RECURSE "${resources}/ui")
file(COPY "${ASSETS}/" DESTINATION "${resources}/ui")
file(GLOB catalogues "${LANG_DIR}/*.po")
file(COPY ${catalogues} DESTINATION "${resources}/ui/lang")

foreach(pair "LOADER|loader" "CPU|cpu" "VIDEO|video" "OS|operating_system")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 input)
    list(GET parts 1 folder)
    get_filename_component(filename "${${input}}" NAME)
    file(MAKE_DIRECTORY "${frameworks}/modules/${folder}")
    file(COPY_FILE "${${input}}" "${frameworks}/modules/${folder}/${filename}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "${MOLTENVK}" "${frameworks}/libMoltenVK.dylib" ONLY_IF_DIFFERENT)
get_filename_component(sdl_filename "${SDL}" NAME)
file(COPY_FILE "${SDL}" "${frameworks}/${sdl_filename}" ONLY_IF_DIFFERENT)

function(run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${ARGN} failed: ${error}")
    endif()
endfunction()

# Copies the libraries `binary` takes from outside the system (package manager
# installs) into the bundle, along with the ones they need in
# turn, and points `binary` at the copies.
function(bundle_dependencies binary)
    execute_process(COMMAND "${OTOOL}" -L "${binary}" OUTPUT_VARIABLE listing)
    string(REGEX MATCHALL "\n\t[^ \n]+" dependencies "${listing}")
    foreach(dependency IN LISTS dependencies)
        string(STRIP "${dependency}" dependency)
        if(dependency MATCHES "^(/usr/lib/|/System/|@)")
            continue()
        endif()
        get_filename_component(filename "${dependency}" NAME)
        set(copy "${frameworks}/${filename}")
        run("${INSTALL_NAME_TOOL}" -change "${dependency}" "@rpath/${filename}" "${binary}")
        if(copy STREQUAL binary OR filename IN_LIST bundled)
            continue()
        endif()
        list(APPEND bundled "${filename}")
        get_filename_component(resolved "${dependency}" REALPATH)
        file(COPY_FILE "${resolved}" "${copy}")
        file(CHMOD "${copy}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
        run("${INSTALL_NAME_TOOL}" -id "@rpath/${filename}" "${copy}")
        bundle_dependencies("${copy}")
    endforeach()
    set(bundled "${bundled}" PARENT_SCOPE)
endfunction()

set(bundled "")
bundle_dependencies("${EXECUTABLE}")

# Ad-hoc signing enables local execution; distribution/notarization needs a
# developer identity. Sign nested code before sealing the application resources.
file(GLOB_RECURSE libraries "${frameworks}/*.dylib")
foreach(library IN LISTS libraries)
    run("${CODESIGN}" --force --sign - "${library}")
endforeach()
run("${CODESIGN}" --force --sign - "${BUNDLE}")
