# Invoked at link time and by nxemu_bundle, so resources never depend on a relink.
foreach(required BUNDLE LOADER CPU VIDEO OS MOLTENVK SCITER LANG CODESIGN INFO_PLIST ICON EXECUTABLE_NAME SHORT_VERSION BUILD_VERSION MINIMUM_MACOS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing bundle input: ${required}")
    endif()
endforeach()
set(runtime "${BUNDLE}/Contents/MacOS")
set(frameworks "${BUNDLE}/Contents/Frameworks")
file(MAKE_DIRECTORY "${frameworks}" "${BUNDLE}/Contents/Resources")
# CMake normally generates Info.plist only during configuration. Restore it during
# packaging too, including incremental builds after bundle metadata was removed.
set(MACOSX_BUNDLE_EXECUTABLE_NAME "${EXECUTABLE_NAME}")
set(MACOSX_BUNDLE_SHORT_VERSION_STRING "${SHORT_VERSION}")
set(MACOSX_BUNDLE_BUNDLE_VERSION "${BUILD_VERSION}")
set(CMAKE_OSX_DEPLOYMENT_TARGET "${MINIMUM_MACOS}")
configure_file("${INFO_PLIST}" "${BUNDLE}/Contents/Info.plist")
file(COPY_FILE "${ICON}" "${BUNDLE}/Contents/Resources/nxemu.icns" ONLY_IF_DIFFERENT)
foreach(pair "LOADER|loader" "CPU|cpu" "VIDEO|video" "OS|operating_system")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 input)
    list(GET parts 1 folder)
    get_filename_component(filename "${${input}}" NAME)
    file(MAKE_DIRECTORY "${frameworks}/modules/${folder}")
    file(COPY_FILE "${${input}}" "${frameworks}/modules/${folder}/${filename}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "${MOLTENVK}" "${frameworks}/libMoltenVK.dylib" ONLY_IF_DIFFERENT)
file(COPY_FILE "${SCITER}" "${runtime}/libsciter.dylib" ONLY_IF_DIFFERENT)
file(COPY "${LANG}" DESTINATION "${BUNDLE}/Contents/Resources")
# Remove only locations generated by the older bundle layout, before sealing.
file(REMOVE_RECURSE "${runtime}/lang" "${runtime}/modules")
# Ad-hoc signing enables local execution; distribution/notarization needs a
# developer identity. Sign nested code before sealing the application resources.
file(GLOB_RECURSE libraries "${runtime}/*.dylib" "${frameworks}/*.dylib")
foreach(library IN LISTS libraries)
    execute_process(COMMAND "${CODESIGN}" --force --sign - "${library}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot sign ${library}: ${error}")
    endif()
endforeach()
execute_process(COMMAND "${CODESIGN}" --force --sign - "${BUNDLE}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot sign bundle: ${error}")
endif()
