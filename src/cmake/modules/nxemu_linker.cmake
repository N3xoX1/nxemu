# Compatible with CMake 3.22, as used by the Android project.
set(NXEMU_LINKER "AUTO" CACHE STRING "Linux linker: AUTO, SYSTEM, LLD or MOLD")
set_property(CACHE NXEMU_LINKER PROPERTY STRINGS AUTO SYSTEM LLD MOLD)
string(TOUPPER "${NXEMU_LINKER}" _nxemu_linker)
if(NOT _nxemu_linker MATCHES "^(AUTO|SYSTEM|LLD|MOLD)$")
    message(FATAL_ERROR "NXEMU_LINKER must be AUTO, SYSTEM, LLD or MOLD")
endif()
set(NXEMU_LINKER_OPTION "")
set(NXEMU_SELECTED_LINKER SYSTEM)
# Android already selects its NDK linker. Never pick a host Linux linker for it,
# and leave macOS and Windows on their platform toolchains.
if(ANDROID OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    if(NOT _nxemu_linker MATCHES "^(AUTO|SYSTEM)$")
        message(FATAL_ERROR "NXEMU_LINKER=${NXEMU_LINKER} is only supported for Linux; use the platform linker here")
    endif()
elseif(NOT _nxemu_linker STREQUAL "SYSTEM")
    if(_nxemu_linker STREQUAL "AUTO" AND CMAKE_CROSSCOMPILING)
        message(STATUS "Cross build: keeping the toolchain linker")
    else()
        # Respect an existing toolchain/user selection in AUTO mode.
        set(_nxemu_user_flags "${CMAKE_EXE_LINKER_FLAGS} ${CMAKE_SHARED_LINKER_FLAGS} ${CMAKE_MODULE_LINKER_FLAGS} ${CMAKE_C_FLAGS} ${CMAKE_CXX_FLAGS}")
        foreach(_config DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
            string(APPEND _nxemu_user_flags " ${CMAKE_EXE_LINKER_FLAGS_${_config}} ${CMAKE_SHARED_LINKER_FLAGS_${_config}} ${CMAKE_MODULE_LINKER_FLAGS_${_config}} ${CMAKE_C_FLAGS_${_config}} ${CMAKE_CXX_FLAGS_${_config}}")
        endforeach()
        if(_nxemu_linker STREQUAL "AUTO" AND
           (CMAKE_LINKER_TYPE OR _nxemu_user_flags MATCHES "-fuse-ld="))
            set(NXEMU_SELECTED_LINKER TOOLCHAIN)
            message(STATUS "Keeping the user/toolchain linker selection")
        else()
            if(_nxemu_linker STREQUAL "AUTO")
                # Clang ThinLTO works directly with LLD without a gold plugin.
                if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
                    set(_nxemu_candidates LLD MOLD)
                else()
                    set(_nxemu_candidates MOLD LLD)
                endif()
            else()
                set(_nxemu_candidates ${_nxemu_linker})
            endif()
            include(CheckLinkerFlag)
            include(CMakePushCheckState)
            foreach(_candidate IN LISTS _nxemu_candidates)
                if(_candidate STREQUAL "LLD")
                    find_program(NXEMU_LLD_EXECUTABLE NAMES ld.lld NO_CMAKE_FIND_ROOT_PATH)
                    set(_program "${NXEMU_LLD_EXECUTABLE}")
                    set(_flag "-fuse-ld=lld")
                else()
                    find_program(NXEMU_MOLD_EXECUTABLE NAMES ld.mold mold NO_CMAKE_FIND_ROOT_PATH)
                    set(_program "${NXEMU_MOLD_EXECUTABLE}")
                    set(_flag "-fuse-ld=mold")
                endif()
                if(NOT _program)
                    continue()
                endif()
                if(CMAKE_C_COMPILER_ID MATCHES "Clang" AND CMAKE_CXX_COMPILER_ID MATCHES "Clang")
                    set(_flag "-fuse-ld=${_program}")
                endif()
                foreach(_lang C CXX)
                    cmake_push_check_state(RESET)
                    if(NXEMU_ENABLE_LTO)
                        string(JOIN " " CMAKE_REQUIRED_FLAGS ${CMAKE_${_lang}_COMPILE_OPTIONS_IPO})
                    endif()
                    # Recheck after changing compiler, LTO or linker, including ON -> OFF.
                    unset(_nxemu_${_lang}_linker_ok CACHE)
                    check_linker_flag(${_lang} "${_flag}" _nxemu_${_lang}_linker_ok)
                    cmake_pop_check_state()
                endforeach()
                if(_nxemu_C_linker_ok AND _nxemu_CXX_linker_ok)
                    set(NXEMU_LINKER_OPTION "${_flag}")
                    set(NXEMU_SELECTED_LINKER "${_candidate}")
                    add_link_options("${NXEMU_LINKER_OPTION}")
                    break()
                endif()
            endforeach()
            if(NOT NXEMU_LINKER_OPTION AND NOT _nxemu_linker STREQUAL "AUTO")
                message(FATAL_ERROR "Requested ${_nxemu_linker} linker is unavailable or cannot link with this compiler/LTO configuration")
            endif()
        endif()
    endif()
endif()
message(STATUS "NxEmu linker: ${NXEMU_SELECTED_LINKER} ${NXEMU_LINKER_OPTION}")

# A ThinLTO link already uses multiple backend threads. Avoid several large
# module links competing for memory at once; compilation stays parallel.
set(NXEMU_LINK_JOBS "1" CACHE STRING "Maximum concurrent Ninja link jobs")
if(NOT NXEMU_LINK_JOBS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "NXEMU_LINK_JOBS must be a positive integer")
endif()
if(NXEMU_ENABLE_LTO AND CMAKE_GENERATOR MATCHES "Ninja" AND NOT CMAKE_JOB_POOL_LINK)
    set_property(GLOBAL APPEND PROPERTY JOB_POOLS nxemu_link=${NXEMU_LINK_JOBS})
    set(CMAKE_JOB_POOL_LINK nxemu_link)
endif()
