# Compiler launchers are supported by Ninja and Makefile generators. Preserve
# launchers supplied by the user or toolchain, including in cross builds.
get_property(_nxemu_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
set(_nxemu_has_launcher OFF)
foreach(_lang IN LISTS _nxemu_languages)
    if(CMAKE_${_lang}_COMPILER_LAUNCHER)
        set(_nxemu_has_launcher ON)
    endif()
endforeach()
set(_nxemu_ccache_default OFF)
set(_nxemu_sccache_default OFF)
if(CMAKE_GENERATOR MATCHES "Ninja|Makefiles" AND NOT _nxemu_has_launcher)
    if(WIN32 AND NOT ANDROID)
        find_program(NXEMU_SCCACHE_EXECUTABLE NAMES sccache NO_CMAKE_FIND_ROOT_PATH)
        if(NXEMU_SCCACHE_EXECUTABLE)
            set(_nxemu_sccache_default ON)
        endif()
    else()
        find_program(NXEMU_CCACHE_EXECUTABLE NAMES ccache NO_CMAKE_FIND_ROOT_PATH)
        if(NXEMU_CCACHE_EXECUTABLE)
            set(_nxemu_ccache_default ON)
        endif()
    endif()
endif()
if(NXEMU_USE_SCCACHE)
    set(_nxemu_ccache_default OFF)
endif()
if(NXEMU_USE_CCACHE)
    set(_nxemu_sccache_default OFF)
endif()
option(NXEMU_USE_CCACHE "Use ccache for languages without a compiler launcher" ${_nxemu_ccache_default})
option(NXEMU_USE_SCCACHE "Use sccache for languages without a compiler launcher" ${_nxemu_sccache_default})
if(NXEMU_USE_CCACHE AND NXEMU_USE_SCCACHE)
    message(FATAL_ERROR "Select only one of NXEMU_USE_CCACHE and NXEMU_USE_SCCACHE")
endif()
if(NXEMU_USE_CCACHE OR NXEMU_USE_SCCACHE)
    if(NOT CMAKE_GENERATOR MATCHES "Ninja|Makefiles")
        message(FATAL_ERROR "Compiler caching requires a Ninja or Makefile generator; on Windows use the windows-x64-ninja preset")
    endif()
    if(NXEMU_USE_SCCACHE)
        find_program(NXEMU_SCCACHE_EXECUTABLE NAMES sccache REQUIRED NO_CMAKE_FIND_ROOT_PATH)
        set(_nxemu_cache_executable "${NXEMU_SCCACHE_EXECUTABLE}")
    else()
        find_program(NXEMU_CCACHE_EXECUTABLE NAMES ccache REQUIRED NO_CMAKE_FIND_ROOT_PATH)
        set(_nxemu_cache_executable "${NXEMU_CCACHE_EXECUTABLE}")
    endif()
    if(NOT EXISTS "${_nxemu_cache_executable}")
        message(FATAL_ERROR "Compiler cache executable does not exist: ${_nxemu_cache_executable}")
    endif()
    foreach(_lang C CXX OBJC OBJCXX)
        if(_lang IN_LIST _nxemu_languages AND NOT CMAKE_${_lang}_COMPILER_LAUNCHER)
            set(CMAKE_${_lang}_COMPILER_LAUNCHER "${_nxemu_cache_executable}")
            message(STATUS "${_lang} compiler cache: ${_nxemu_cache_executable}")
        endif()
    endforeach()
endif()

# PCH consumers are not reusable with the compiler caches used by our CI.
# Prefer caching each translation unit instead of recompiling PCH consumers
# on every fresh runner. An explicit user setting still takes precedence.
if(_nxemu_has_launcher OR NXEMU_USE_CCACHE OR NXEMU_USE_SCCACHE)
    if(NOT DEFINED CMAKE_DISABLE_PRECOMPILE_HEADERS)
        set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
        message(STATUS "Compiler cache: disabling precompiled headers for reusable objects")
    endif()
endif()

# A shared compiler PDB prevents cache hits. Embed symbols in cached objects;
# nxemu_apply_link_settings() still requests the final executable/module PDBs.
# Apply this also when a cache launcher was supplied explicitly.
if(MSVC)
    set(_nxemu_msvc_cache OFF)
    foreach(_lang C CXX)
        if(CMAKE_${_lang}_COMPILER_LAUNCHER MATCHES "(ccache|sccache)(\\.exe)?(;|$)")
            set(_nxemu_msvc_cache ON)
        endif()
    endforeach()
    if(_nxemu_msvc_cache)
        set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT Embedded)
        foreach(_lang C CXX)
            foreach(_suffix "" _DEBUG _RELEASE _RELWITHDEBINFO _MINSIZEREL)
                string(REPLACE "/Zi" "/Z7" CMAKE_${_lang}_FLAGS${_suffix} "${CMAKE_${_lang}_FLAGS${_suffix}}")
                string(REPLACE "/ZI" "/Z7" CMAKE_${_lang}_FLAGS${_suffix} "${CMAKE_${_lang}_FLAGS${_suffix}}")
                string(REGEX REPLACE "(^| )/(FS|MP[0-9]*)( |$)" " " CMAKE_${_lang}_FLAGS${_suffix} "${CMAKE_${_lang}_FLAGS${_suffix}}")
            endforeach()
        endforeach()
    endif()
endif()
unset(_nxemu_ccache_default)
unset(_nxemu_sccache_default)
unset(_nxemu_has_launcher)
unset(_nxemu_languages)
unset(_nxemu_cache_executable)
unset(_nxemu_msvc_cache)

# Some dependencies append /Zi and /MP directly to their target options,
# overriding the cache-compatible debug format selected above.
function(nxemu_apply_dependency_cache_settings target)
    if(MSVC AND CMAKE_CXX_COMPILER_LAUNCHER MATCHES "(ccache|sccache)(\\.exe)?(;|$)")
        get_target_property(_options ${target} COMPILE_OPTIONS)
        if(_options)
            list(FILTER _options EXCLUDE REGEX "^/(Zi|ZI|MP[0-9]*)$")
            set_property(TARGET ${target} PROPERTY COMPILE_OPTIONS "${_options}")
        endif()
        set_property(TARGET ${target} PROPERTY MSVC_DEBUG_INFORMATION_FORMAT Embedded)
    endif()
endfunction()
