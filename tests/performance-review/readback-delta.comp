#version 450
layout(local_size_x=128) in;
layout(set=0,binding=0,std430) readonly buffer Current { uint current_data[]; };
layout(set=0,binding=1,std430) readonly buffer Reference { uint reference_data[]; };
layout(set=0,binding=2,std430) writeonly buffer Mask { uint changed_blocks[]; };
layout(push_constant) uniform Parameters { uint words; } params;
shared uint changed;
void main() {
    if(gl_LocalInvocationIndex==0)changed=0;
    barrier();
    const uint begin=gl_WorkGroupID.x*16384u;
    for(uint i=gl_LocalInvocationIndex;i<16384u && begin+i<params.words;i+=128u) {
        if(current_data[begin+i]!=reference_data[begin+i])atomicOr(changed,1u);
    }
    barrier();
    if(gl_LocalInvocationIndex==0)changed_blocks[gl_WorkGroupID.x]=changed;
}
