#version 450
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
layout(binding=0,rgba16f) uniform image3D volume;
layout(binding=1) uniform sampler3D sampled_volume;
layout(binding=2,std430) buffer Results { uint result[]; };
layout(push_constant) uniform Parameters { uint phase; uint seed; };
void main() {
    ivec3 p=ivec3(gl_GlobalInvocationID);
    ivec3 extent=imageSize(volume);
    if(any(greaterThanEqual(p,extent))) return;
    uint index=uint((p.z*extent.y+p.y)*extent.x+p.x);
    if(phase==0) {
        float value=float((uint(p.x^p.y^p.z)+seed)%4u+1u)*0.25;
        imageStore(volume,p,vec4(value));
    } else {
        float value=textureLod(sampled_volume,(vec3(p)+0.5)/vec3(extent),0.0).r;
        result[index]=isnan(value)?0xffffffffu:uint(round(value*4.0));
    }
}
