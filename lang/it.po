msgid "System"
msgstr "Sistema"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Application"
msgstr "Applicazione"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shortcuts"
msgstr "Scorciatoie"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops."
msgstr "Un gioco è in esecuzione: le opzioni disattivate non possono essere modificate finché non viene arrestato."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Picture"
msgstr "Immagine"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Anti-aliasing"
msgstr "Antialiasing"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Smooths jagged edges."
msgstr "Smussa i bordi seghettati."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Anisotropic filtering"
msgstr "Filtro anisotropico"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps textures sharp seen at a slant."
msgstr "Mantiene nitide le texture viste in obliquo."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Accuracy"
msgstr "Precisione"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Accuracy level"
msgstr "Livello di precisione"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How closely the graphics chip is imitated."
msgstr "La fedeltà con cui viene emulato il chip grafico."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Videos at their own speed"
msgstr "Video alla velocità normale"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Even when the speed is not limited."
msgstr "Anche quando la velocità non è limitata."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Textures and video"
msgstr "Texture e video"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "ASTC recompression"
msgstr "Ricompressione ASTC"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Less graphics memory, for a lesser picture."
msgstr "Meno memoria grafica, a scapito della qualità dell'immagine."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Graphics memory"
msgstr "Memoria grafica"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How much of it games may take."
msgstr "La quantità che possono usare i giochi."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shaders"
msgstr "Shader"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keep shaders on the disk"
msgstr "Conserva gli shader su disco"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Games stutter less from their second start."
msgstr "I giochi hanno meno scatti dal secondo avvio."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off only to look for a fault."
msgstr "Disattivalo solo per individuare un problema."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Build shaders in the background"
msgstr "Compila gli shader in background"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Less stutter; things can show late. A hack."
msgstr "Meno scatti; alcuni elementi possono apparire in ritardo. È un espediente."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Performance"
msgstr "Prestazioni"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keep the graphics device busy"
msgstr "Mantieni occupato il dispositivo grafico"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "So that it does not slow its clock. Uses more power."
msgstr "Impedisce che riduca la frequenza. Consuma più energia."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor and memory"
msgstr "Processore e memoria"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Console memory"
msgstr "Memoria della console"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "More than the console has: for heavy mods."
msgstr "Più di quella della console: per mod esigenti."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Emulation"
msgstr "Emulazione"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/hotkeys.h
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Limit speed"
msgstr "Limita velocità"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off: as fast as the computer can."
msgstr "Disattivato: alla massima velocità consentita dal computer."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "On, games run at the speed chosen: 100% is the speed of the console."
msgstr "Se attivo, i giochi vengono eseguiti alla velocità scelta: il 100% corrisponde alla velocità della console."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Audio"
msgstr "Audio"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output device"
msgstr "Dispositivo di uscita"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Where the sound of games is played."
msgstr "Dove viene riprodotto l'audio dei giochi."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output mode"
msgstr "Modalità di uscita"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Surround needs speakers that play it."
msgstr "L'audio surround richiede altoparlanti compatibili."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output engine"
msgstr "Motore di uscita"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What plays the sound on this computer."
msgstr "Cosa riproduce l'audio su questo computer."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Input device"
msgstr "Dispositivo di ingresso"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The microphone games listen to."
msgstr "Il microfono usato dai giochi."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
#: src/nxemu/ui/assets/main_window.rml
#: src/nxemu/ui/views/hotkeys.h
#: src/nxemu/ui/views/main_window.cpp
#: src/android/app/src/main/jni/ui/ui_activity.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Controllers"
msgstr "Controller"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Vibration"
msgstr "Vibrazione"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "For every player. Each has a switch of their own."
msgstr "Per tutti i giocatori. Ognuno ha anche un interruttore individuale."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Behaviour"
msgstr "Comportamento"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/main_window.cpp
msgid "Start games in fullscreen"
msgstr "Avvia giochi a schermo intero"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/main_window.cpp
msgid "Start games with UI hidden"
msgstr "Avvia giochi con interfaccia nascosta"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Confirm before stopping"
msgstr "Conferma prima dell'arresto"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Asks before a running game is stopped."
msgstr "Chiede conferma prima di arrestare un gioco in esecuzione."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Discord presence"
msgstr "Presenza su Discord"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shows what you play in Discord when it runs."
msgstr "Mostra a cosa stai giocando su Discord quando è aperto."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Emulation diagnostics"
msgstr "Diagnostica emulazione"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor engine"
msgstr "Motore del processore"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How the game's code is run."
msgstr "Come viene eseguito il codice del gioco."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor accuracy"
msgstr "Precisione del processore"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "For the engine that translates the code."
msgstr "Per il motore che traduce il codice."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Driver pipeline cache"
msgstr "Cache delle pipeline del driver"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shaders load faster with some drivers."
msgstr "Gli shader si caricano più rapidamente con alcuni driver."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Memory reads"
msgstr "Letture della memoria"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How carefully the chip reads what games write."
msgstr "Con quale rigore il chip legge i dati scritti dai giochi."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Command synchronization"
msgstr "Sincronizzazione dei comandi"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps the order games give their commands in."
msgstr "Rispetta l'ordine dei comandi inviati dai giochi."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Slower, and steadier. Off, some games show faults, hang or crash."
msgstr "Più lento e più stabile. Se disattivato, alcuni giochi mostrano difetti, si bloccano o si arrestano."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Fast readback"
msgstr "Rilettura rapida"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Lets games read what the chip drew without waiting for it."
msgstr "Permette ai giochi di leggere ciò che il chip ha disegnato senza aspettarlo."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Needs High or Extreme accuracy. Much faster in some games, keeping High drawing. What games read can be a frame late."
msgstr "Richiede la precisione Alta o Estrema. Molto più veloce in alcuni giochi, mantenendo il disegno della precisione Alta. Ciò che i giochi leggono può arrivare con un fotogramma di ritardo."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Reactive flushing"
msgstr "Svuotamento reattivo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Brings memory up to date when it is read."
msgstr "Aggiorna la memoria quando viene letta."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "More exact than guessing ahead when it will be read."
msgstr "Più preciso che prevedere quando verrà letta."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Barrier feedback loops"
msgstr "Cicli di feedback delle barriere"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Draws transparent things right in some games."
msgstr "Visualizza correttamente gli elementi trasparenti in alcuni giochi."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Fast GPU time"
msgstr "Tempi GPU rapidi"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Most games then draw their highest resolution."
msgstr "La maggior parte dei giochi usa così la risoluzione massima."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Games that lower their resolution when the chip is slow are told it is fast."
msgstr "Indica che il chip è veloce ai giochi che riducono la risoluzione quando è lento."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "ASTC decoding"
msgstr "Decodifica ASTC"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What decodes the textures of this kind."
msgstr "Cosa decodifica le texture di questo tipo."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Video decoding"
msgstr "Decodifica video"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What decodes the videos of games."
msgstr "Cosa decodifica i video dei giochi."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Threads and input"
msgstr "Thread e input"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Graphics on their own thread"
msgstr "Grafica su un thread dedicato"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Should stay on."
msgstr "Si consiglia di lasciarlo attivo."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Presentation on its own thread"
msgstr "Presentazione su un thread dedicato"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "A little faster on some computers."
msgstr "Leggermente più veloce su alcuni computer."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Multicore"
msgstr "Multicore"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The cores of the console on as many threads."
msgstr "I core della console su altrettanti thread."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off, games run on one thread: much slower, to look for a fault."
msgstr "Se disattivato, i giochi usano un solo thread: molto più lento, per individuare problemi."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "CPU and system in step"
msgstr "Sincronizza CPU e sistema"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps the processor and the system's answers in order."
msgstr "Rispetta l'ordine tra il processore e le risposte del sistema."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Needs multicore."
msgstr "Richiede il multicore."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Accurate vibration"
msgstr "Vibrazione precisa"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Every change is sent: some controllers lag."
msgstr "Viene inviata ogni variazione: alcuni controller rispondono in ritardo."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Log"
msgstr "Registro"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Show the log console"
msgstr "Mostra la console del registro"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The log is also written as it comes."
msgstr "Il registro viene mostrato anche in tempo reale."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Log filter"
msgstr "Filtro del registro"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What is written, as class:level."
msgstr "Cosa viene registrato, nel formato classe:livello."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Click a shortcut, then press the keys or hold and release the gamepad buttons. To clear it, use the cross beside it, or click it and press Delete."
msgstr "Fai clic su una scorciatoia, poi premi i tasti o tieni premuti e rilascia i pulsanti del controller. Per cancellarla, usa la croce accanto oppure fai clic sulla scorciatoia e premi Canc."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "In game"
msgstr "In gioco"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Restore defaults"
msgstr "Ripristina valori predefiniti"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Inherit all settings"
msgstr "Eredita tutte le impostazioni"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Restore the defaults of all the tabs?"
msgstr "Ripristinare i valori predefiniti di tutte le schede?"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Remove your overrides and re-enable NXEmu settings for this game?"
msgstr "Rimuovere le impostazioni personalizzate e riattivare quelle di NXEmu per questo gioco?"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/profiles_dialog.rml
msgid "Keep"
msgstr "Mantieni"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Restore"
msgstr "Ripristina"

