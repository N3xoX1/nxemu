#: src/nxemu/ui/assets/directories_dialog.rml
msgid "Add the directories your games are in. Updates, DLC and mods in the same directories are matched to their games automatically. Turn on Scan subfolders to also look in the folders inside a directory."
msgstr "Aggiungi le cartelle in cui si trovano i tuoi giochi. Aggiornamenti, DLC e mod nelle stesse cartelle vengono associati automaticamente ai loro giochi. Attiva Cerca nelle sottocartelle per cercare anche nelle cartelle al loro interno."

#: src/nxemu/ui/assets/directories_dialog.rml
msgid "Add a directory"
msgstr "Aggiungi una cartella"

#: src/nxemu/ui/assets/directories_dialog.rml
msgid "The game directories cannot change while a game is running."
msgstr "Le cartelle dei giochi non possono essere modificate mentre un gioco è in esecuzione."

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Install firmware"
msgstr "Installa firmware"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Source"
msgstr "Origine"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Install"
msgstr "Installa"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Finish"
msgstr "Fine"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Where is the firmware?"
msgstr "Dove si trova il firmware?"

#: src/nxemu/ui/assets/firmware_dialog.rml
