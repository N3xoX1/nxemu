msgstr "Профили"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/directories_dialog.rml
#: src/nxemu/ui/assets/general_dialog.rml
#: src/nxemu/ui/assets/profiles_dialog.rml
msgid "Game directories"
msgstr "Папки с играми"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/directories_dialog.rml
#: src/nxemu/ui/assets/general_dialog.rml
#: src/nxemu/ui/assets/profiles_dialog.rml
msgid "Advanced"
msgstr "Расширенные"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/directories_dialog.rml
#: src/nxemu/ui/assets/general_dialog.rml
#: src/nxemu/ui/assets/profiles_dialog.rml
msgid "Debug"
msgstr "Отладка"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_activity.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Graphics"
msgstr "Графика"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "System"
msgstr "Система"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Application"
msgstr "Приложение"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shortcuts"
msgstr "Сочетания клавиш"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops."
msgstr "Игра запущена: недоступные параметры можно изменить только после её остановки."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Picture"
msgstr "Изображение"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Anti-aliasing"
msgstr "Сглаживание"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Smooths jagged edges."
msgstr "Сглаживает неровные края."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Anisotropic filtering"
msgstr "Анизотропная фильтрация"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps textures sharp seen at a slant."
msgstr "Сохраняет резкость текстур, просмотренных под углом."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Accuracy"
msgstr "Точность"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Accuracy level"
msgstr "Уровень точности"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How closely the graphics chip is imitated."
msgstr "Точность эмуляции графического чипа."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Videos at their own speed"
msgstr "Видео с обычной скоростью"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Even when the speed is not limited."
msgstr "Даже если скорость не ограничена."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Textures and video"
msgstr "Текстуры и видео"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "ASTC recompression"
msgstr "Рекомпрессия ASTC"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Less graphics memory, for a lesser picture."
msgstr "Меньше графической памяти за счет менее точного изображения."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Graphics memory"
msgstr "Графическая память"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How much of it games may take."
msgstr "Сумма, которую могут использовать игры."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shaders"
msgstr "Шейдеры"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keep shaders on the disk"
msgstr "Хранить шейдеры на диске"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Games stutter less from their second start."
msgstr "Игры меньше подтормаживают начиная со второго запуска."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off only to look for a fault."
msgstr "Отключайте только для устранения неполадок."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Build shaders in the background"
msgstr "Компилировать шейдеры в фоне"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Less stutter; things can show late. A hack."
msgstr "Меньше дерганий; некоторые предметы могут появиться с опозданием. Приближение."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Performance"
msgstr "Производительность"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keep the graphics device busy"
msgstr "Держите графическое устройство занятым"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "So that it does not slow its clock. Uses more power."
msgstr "Предотвращает снижение частоты. Потребляет больше энергии."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor and memory"
msgstr "Процессор и память"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Console memory"
msgstr "Память консоли"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "More than the console has: for heavy mods."
msgstr "Больше, чем на консоли: для требовательных модов."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Emulation"
msgstr "Эмуляция"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/hotkeys.h
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Limit speed"
msgstr "Ограничить скорость"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off: as fast as the computer can."
msgstr "Отключено: так быстро, как позволяет компьютер."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "On, games run at the speed chosen: 100% is the speed of the console."
msgstr "При включении игры запускаются на выбранной скорости: 100% соответствует скорости консоли."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Audio"
msgstr "Аудио"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output device"
msgstr "Устройство вывода"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Where the sound of games is played."
msgstr "Где воспроизводится игровой звук."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output mode"
msgstr "Режим вывода"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Surround needs speakers that play it."
msgstr "Для объемного звука требуются совместимые динамики."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output engine"
msgstr "Модуль вывода звука"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What plays the sound on this computer."
msgstr "Что воспроизводит звук на этом компьютере."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Input device"
msgstr "Устройство ввода"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The microphone games listen to."
msgstr "Микрофон, используемый в играх."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
#: src/nxemu/ui/assets/main_window.rml
#: src/nxemu/ui/views/hotkeys.h
#: src/nxemu/ui/views/main_window.cpp
#: src/android/app/src/main/jni/ui/ui_activity.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Controllers"
msgstr "Контроллеры"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Vibration"
msgstr "Вибрация"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "For every player. Each has a switch of their own."
msgstr "Для всех игроков. У каждого также есть своя настройка."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Behaviour"
msgstr "Поведение"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/main_window.cpp
msgid "Start games in fullscreen"
msgstr "Запускать игры в полноэкранном режиме"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/main_window.cpp
msgid "Start games with UI hidden"
msgstr "Запускать игры со скрытым интерфейсом"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Confirm before stopping"
msgstr "Подтверждать остановку игры"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Asks before a running game is stopped."
msgstr "Запрашивает подтверждение перед остановкой текущей игры."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Discord presence"
msgstr "Присутствие Discord"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shows what you play in Discord when it runs."
msgstr "Показывает, во что вы играете, если Discord запущен."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Emulation diagnostics"
msgstr "Диагностика эмуляции"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor engine"
msgstr "Процессорный движок"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How the game's code is run."
msgstr "Способ выполнения игрового кода."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor accuracy"
msgstr "Точность процессора"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "For the engine that translates the code."
msgstr "Для движка, который транслирует код."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Driver pipeline cache"
msgstr "Кэш конвейеров драйвера"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shaders load faster with some drivers."
msgstr "Шейдеры загружаются быстрее с некоторыми драйверами."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Memory reads"
msgstr "Чтение памяти"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How carefully the chip reads what games write."
msgstr "Насколько строго чип читает данные, записанные играми."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Command synchronization"
msgstr "Синхронизация команд"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps the order games give their commands in."
msgstr "Соблюдает порядок команд, отправляемых играми."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Slower, and steadier. Off, some games show faults, hang or crash."
msgstr "Медленнее, но стабильнее. Без этой функции в некоторых играх появляются ошибки, зависания или сбои."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Fast readback"
msgstr "Быстрое обратное чтение"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Lets games read what the chip drew without waiting for it."
msgstr "Позволяет играм читать то, что нарисовал чип, не дожидаясь его."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Needs High or Extreme accuracy. Much faster in some games, keeping High drawing. What games read can be a frame late."
msgstr "Требует точности «Высокая» или «Экстремальная». В некоторых играх намного быстрее, с отрисовкой уровня «Высокая». Прочитанное играми может запаздывать на кадр."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Reactive flushing"
msgstr "Реактивный сброс"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Brings memory up to date when it is read."
msgstr "Обновляет память по мере ее чтения."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "More exact than guessing ahead when it will be read."
msgstr "Точнее, чем предсказывать момент чтения памяти."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Barrier feedback loops"
msgstr "Циклы обратной связи барьеров"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Draws transparent things right in some games."
msgstr "Правильное отображение прозрачных элементов в некоторых играх."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Fast GPU time"
msgstr "Быстрое время GPU"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Most games then draw their highest resolution."
msgstr "Большинство игр используют максимальное разрешение."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Games that lower their resolution when the chip is slow are told it is fast."
msgstr "Сообщает о быстром графическом чипе играм, которые снижают разрешение при его замедлении."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "ASTC decoding"
msgstr "Декодирование ASTC"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What decodes the textures of this kind."
msgstr "Который декодирует текстуры этого типа."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Video decoding"
msgstr "Декодирование видео"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What decodes the videos of games."
msgstr "Который декодирует игровые видео."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Threads and input"
msgstr "Потоки и ввод"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Graphics on their own thread"
msgstr "Графика в отдельном потоке"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Should stay on."
msgstr "Оставьте включенным."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Presentation on its own thread"
msgstr "Вывод изображения в отдельном потоке"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "A little faster on some computers."
msgstr "На некоторых компьютерах немного быстрее."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Multicore"
msgstr "Многоядерный"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The cores of the console on as many threads."
msgstr "Каждое ядро консоли выполняется в отдельном потоке."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off, games run on one thread: much slower, to look for a fault."
msgstr "При отключении игры выполняются в одном потоке. Намного медленнее; для поиска ошибок."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "CPU and system in step"
msgstr "Синхронизировать CPU и систему"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps the processor and the system's answers in order."
msgstr "Соблюдает порядок ответов процессора и системы."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Needs multicore."
msgstr "Требуется многоядерный режим."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Accurate vibration"
msgstr "Точная вибрация"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Every change is sent: some controllers lag."
msgstr "Каждый вариант передается: некоторые контроллеры реагируют с опозданием."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Log"
msgstr "Журнал"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Show CPU backend in the title bar"
msgstr "Показать бэкенд CPU в заголовке окна"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The active backend, instruction set and address-space width."
msgstr "Активный бэкенд, набор инструкций и разрядность адресного пространства."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Show the log console"
msgstr "Показать консоль журнала"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The log is also written as it comes."
msgstr "Там же по ходу отображается журнал."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Log filter"
msgstr "Фильтр журнала"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What is written, as class:level."
msgstr "Что записывается в журнал, в формате класс:уровень."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Click a shortcut, then press the keys or hold and release the gamepad buttons. To clear it, use the cross beside it, or click it and press Delete."
msgstr "Выберите сочетание и нажмите клавиши либо удерживайте и отпустите кнопки геймпада. Чтобы удалить назначение, нажмите крестик рядом или выберите сочетание и нажмите Delete."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "In game"
msgstr "В игре"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Restore defaults"
msgstr "Восстановить настройки по умолчанию"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Inherit all settings"
msgstr "Наследовать все настройки"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Restore the defaults of all the tabs?"
msgstr "Восстановить значения по умолчанию на всех вкладках?"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Remove your overrides and re-enable NXEmu settings for this game?"
msgstr "Удалить настройки и снова включить настройки NXEmu для этой игры?"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/profiles_dialog.rml
msgid "Keep"
msgstr "Продолжайте"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Restore"
msgstr "Повторить"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/directories_dialog.rml
#: src/nxemu/ui/assets/firmware_dialog.rml
#: src/nxemu/ui/assets/general_dialog.rml
#: src/nxemu/ui/assets/main_window.rml
#: src/nxemu/ui/assets/profiles_dialog.rml
#: src/nxemu/ui/views/firmware_dialog.cpp
msgid "Close"
msgstr "Закрыть"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "On, games see this player's controller as plugged into the console."
msgstr "Включено, игра видит контроллер этого игрока как подключенный к консоли."

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Connected"
msgstr "Подключено"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Controller"
msgstr "Контроллер"

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/nxemu/ui/views/controller_dialog.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Left stick"
msgstr "Левый джойстик"

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Deadzone"
msgstr "Мертвая зона"

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Range"
