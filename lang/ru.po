msgstr "Самый быстрый. Большинство игр отображаются корректно, но частицы зачастую нет."

#: src/nxemu/ui/views/advanced_dialog.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "High"
msgstr "Высокий"

