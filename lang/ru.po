msgid "No stutter, but textures show wrong until they are decoded."
msgstr "Никаких заиканий, но текстуры некорректны до декодирования."

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The best picture, and the most memory."
msgstr "Лучшее изображение и самое большое потребление памяти."

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "BC1 (low quality)"
msgstr "BC1 (низкое качество)"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The least memory."
msgstr "Самое низкое потребление памяти."

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "BC3 (medium quality)"
msgstr "BC3 (среднее качество)"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Less memory."
msgstr "Меньше памяти."

#: src/nxemu/ui/views/advanced_dialog.cpp
