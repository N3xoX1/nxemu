#: src/nxemu/ui/assets/about_dialog.rml
msgid "About NXEmu"
msgstr "О NXEmu"

#: src/nxemu/ui/assets/about_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "NXEmu is an experimental open-source Nintendo Switch emulator."
msgstr "NXEmu — экспериментальный эмулятор Nintendo Switch с открытым исходным кодом."

#: src/nxemu/ui/assets/about_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "You are responsible for ensuring your use of this software complies with the laws in your jurisdiction."
msgstr "Вы несете ответственность за то, чтобы использование вами этого программного обеспечения соответствовало законам вашей страны."

#: src/nxemu/ui/assets/about_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "With thanks to"
msgstr "Благодарности"

#: src/nxemu/ui/assets/about_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "the yuzu project, Fabrice, Alexwpi, Stardust, and NullVector"
msgstr "команда проекта yuzu, Fabrice, Alexwpi, Stardust и NullVector"

#: src/nxemu/ui/assets/about_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Website"
msgstr "Веб-сайт"

#: src/nxemu/ui/assets/about_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Source Code"
msgstr "Исходный код"

#: src/nxemu/ui/assets/about_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "\"Nintendo Switch\" is a trademark of Nintendo. NXEmu is not affiliated with Nintendo in any way."
msgstr "«Nintendo Switch» является товарным знаком Nintendo. NXEmu никоим образом не связан с Nintendo."

#: src/nxemu/ui/assets/about_dialog.rml
msgid "OK"
msgstr "ОК"

