msgstr "Безопасно, если уровень точности высокий или экстремальный."

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Unsafe"
msgstr "Небезопасно"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Faster."
msgstr "Быстрее."

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Safe"
msgstr "Конечно"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Steadier: it fixes some games."
msgstr "Более стабильно: исправлены некоторые игры."

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Processor"
msgstr "Процессор"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The slowest, and the safest."
msgstr "Самый медленный и безопасный."

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The usual choice."
msgstr "Обычный выбор."

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Processor, in the background"
msgstr "ЦП, фон"

