msgid "Graphics"
msgstr "Gráficos"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "System"
msgstr "Sistema"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Application"
msgstr "Aplicação"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shortcuts"
msgstr "Atalhos"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "A game is running: what is greyed out cannot change until it stops."
msgstr "Está um jogo em execução: as opções a cinzento só podem ser alteradas depois de o parar."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Picture"
msgstr "Imagem"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Anti-aliasing"
msgstr "Antialiasing"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Smooths jagged edges."
msgstr "Suaviza as arestas irregulares."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Anisotropic filtering"
msgstr "Filtragem anisotrópica"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps textures sharp seen at a slant."
msgstr "Preserva a nitidez das texturas vistas em ângulo."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Accuracy"
msgstr "Precisão"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Accuracy level"
msgstr "Nível de precisão"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How closely the graphics chip is imitated."
msgstr "A fidelidade com que o chip gráfico é emulado."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Videos at their own speed"
msgstr "Vídeos à velocidade normal"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Even when the speed is not limited."
msgstr "Mesmo quando a velocidade não é limitada."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Textures and video"
msgstr "Texturas e vídeo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "ASTC recompression"
msgstr "Recompressão ASTC"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Less graphics memory, for a lesser picture."
msgstr "Menos memória gráfica, à custa de uma imagem menos fiel."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Graphics memory"
msgstr "Memória gráfica"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How much of it games may take."
msgstr "A quantidade que os jogos podem utilizar."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shaders"
msgstr "Shaders"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keep shaders on the disk"
msgstr "Guardar shaders no disco"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Games stutter less from their second start."
msgstr "Os jogos têm menos solavancos a partir do segundo arranque."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off only to look for a fault."
msgstr "Desative apenas para solucionar problemas."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Build shaders in the background"
msgstr "Compilar shaders em segundo plano"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Less stutter; things can show late. A hack."
msgstr "Menos espasmos; alguns itens podem aparecer atrasados. Uma aproximação."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Performance"
msgstr "Desempenho"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keep the graphics device busy"
msgstr "Mantenha o dispositivo gráfico ocupado"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "So that it does not slow its clock. Uses more power."
msgstr "Impede que reduza a sua frequência. Consome mais energia."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor and memory"
msgstr "Processador e memória"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Console memory"
msgstr "Memória da consola"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "More than the console has: for heavy mods."
msgstr "Mais do que na consola: para mods exigentes."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Emulation"
msgstr "Emulação"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/hotkeys.h
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Limit speed"
msgstr "Limitar velocidade"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off: as fast as the computer can."
msgstr "Desativado: Tão rápido quanto o computador permitir."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "On, games run at the speed chosen: 100% is the speed of the console."
msgstr "Quando activado, os jogos correm à velocidade escolhida: 100% corresponde à velocidade da consola."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Audio"
msgstr "Audio"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output device"
msgstr "Dispositivo de saída"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Where the sound of games is played."
msgstr "Onde é reproduzido o áudio do jogo."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output mode"
msgstr "Modo de saída"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Surround needs speakers that play it."
msgstr "O som surround requer colunas compatíveis."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output engine"
msgstr "Motor de saída de áudio"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What plays the sound on this computer."
msgstr "O que reproduz som neste computador."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Input device"
msgstr "Dispositivo de entrada"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The microphone games listen to."
msgstr "O microfone utilizado pelos jogos."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
#: src/nxemu/ui/assets/main_window.rml
#: src/nxemu/ui/views/hotkeys.h
#: src/nxemu/ui/views/main_window.cpp
#: src/android/app/src/main/jni/ui/ui_activity.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Controllers"
msgstr "Comandos"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Vibration"
msgstr "Vibração"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "For every player. Each has a switch of their own."
msgstr "Para todos os jogadores. Cada um tem também a sua própria configuração."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Behaviour"
msgstr "Comportamento"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/main_window.cpp
msgid "Start games in fullscreen"
msgstr "Iniciar jogos em ecrã completo"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/main_window.cpp
msgid "Start games with UI hidden"
msgstr "Iniciar jogos com a interface oculta"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Confirm before stopping"
msgstr "Confirmar antes de parar o jogo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Asks before a running game is stopped."
msgstr "Pede confirmação antes de interromper um jogo em curso."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Discord presence"
msgstr "Presença Discord"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shows what you play in Discord when it runs."
msgstr "Mostra no Discord o jogo que está a jogar, quando o Discord está aberto."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Emulation diagnostics"
msgstr "Diagnóstico da emulação"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor engine"
msgstr "Mecanismo do processador"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How the game's code is run."
msgstr "A forma como o código do jogo é executado."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor accuracy"
msgstr "Precisão do processador"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "For the engine that translates the code."
msgstr "Para o motor que traduz o código."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Driver pipeline cache"
msgstr "Cache de pipelines do controlador"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shaders load faster with some drivers."
msgstr "Os shaders carregam mais depressa com alguns controladores."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Memory reads"
msgstr "Leituras de memória"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How carefully the chip reads what games write."
msgstr "Com que rigor o chip lê os dados gravados pelos jogos."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Command synchronization"
msgstr "Sincronização de comandos"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps the order games give their commands in."
msgstr "Respeita a ordem dos comandos enviados pelos jogos."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Slower, and steadier. Off, some games show faults, hang or crash."
msgstr "Mais lento, mas mais estável. Sem esta opção, alguns jogos apresentam erros, bloqueiam ou encerram inesperadamente."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Fast readback"
msgstr "Releitura rápida"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Lets games read what the chip drew without waiting for it."
msgstr "Permite que os jogos leiam o que o chip desenhou sem esperar por ele."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Needs High or Extreme accuracy. Much faster in some games, keeping High drawing. What games read can be a frame late."
msgstr "Requer precisão Alta ou Extrema. Muito mais rápido em alguns jogos, mantendo o desenho da precisão Alta. O que os jogos leem pode chegar com uma imagem de atraso."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Reactive flushing"
msgstr "Flush reativo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Brings memory up to date when it is read."
msgstr "Atualiza a memória à medida que é lida."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "More exact than guessing ahead when it will be read."
msgstr "Mais preciso do que prever quando a memória será lida."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Barrier feedback loops"
msgstr "Ciclos de feedback de barreira"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Draws transparent things right in some games."
msgstr "Apresenta corretamente os elementos transparentes em alguns jogos."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Fast GPU time"
msgstr "Tempo GPU rápido"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Most games then draw their highest resolution."
msgstr "A maioria dos jogos utiliza a sua resolução máxima."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Games that lower their resolution when the chip is slow are told it is fast."
msgstr "Indica que o chip gráfico é rápido aos jogos que reduzem a resolução quando este é lento."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "ASTC decoding"
msgstr "Descodificação ASTC"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What decodes the textures of this kind."
msgstr "Que descodifica texturas deste tipo."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Video decoding"
msgstr "Descodificação de vídeo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What decodes the videos of games."
msgstr "Que descodifica vídeos de jogos."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Threads and input"
msgstr "Threads e entrada"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Graphics on their own thread"
msgstr "Gráficos numa thread dedicada"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Should stay on."
msgstr "Deixar habilitado."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Presentation on its own thread"
msgstr "Apresentação numa thread dedicada"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "A little faster on some computers."
msgstr "Um pouco mais rápido em alguns computadores."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Multicore"
msgstr "Multinúcleo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The cores of the console on as many threads."
msgstr "Cada núcleo da consola é executado numa thread própria."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off, games run on one thread: much slower, to look for a fault."
msgstr "Quando desativado, os jogos usam uma só thread. Muito mais lento; serve para diagnosticar problemas."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "CPU and system in step"
msgstr "Sincronizar CPU e sistema"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps the processor and the system's answers in order."
msgstr "Respeita a ordem entre as respostas do processador e do sistema."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Needs multicore."
msgstr "Requer o modo multi-core."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Accurate vibration"
msgstr "Vibração precisa"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Every change is sent: some controllers lag."
msgstr "Cada variação é transmitida: alguns controladores reagem tarde."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Log"
msgstr "Registo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Show the log console"
msgstr "Mostrar consola de registo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The log is also written as it comes."
msgstr "O registo também é apresentado aí à medida que avança."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Log filter"
msgstr "Filtro de registo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What is written, as class:level."
msgstr "O que é registado, no formato classe:nível."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Click a shortcut, then press the keys or hold and release the gamepad buttons. To clear it, use the cross beside it, or click it and press Delete."
msgstr "Clique num atalho e prima as teclas ou mantenha premidos e solte os botões do comando. Para apagar, use a cruz ao lado ou clique no atalho e prima Delete."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "In game"
msgstr "Em jogo"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Restore defaults"
msgstr "Restaurar predefinições"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Inherit all settings"
msgstr "Herdar todas as definições"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Restore the defaults of all the tabs?"
msgstr "Repor as predefinições de todos os separadores?"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Remove your overrides and re-enable NXEmu settings for this game?"
msgstr "Remover as suas personalizações e reativar as definições NXEmu para este jogo?"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/profiles_dialog.rml
msgid "Keep"
msgstr "Manter"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Restore"
msgstr "Refazer"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/directories_dialog.rml
#: src/nxemu/ui/assets/firmware_dialog.rml
#: src/nxemu/ui/assets/general_dialog.rml
#: src/nxemu/ui/assets/main_window.rml
#: src/nxemu/ui/assets/profiles_dialog.rml
#: src/nxemu/ui/views/firmware_dialog.cpp
msgid "Close"
msgstr "Fechar"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "On, games see this player's controller as plugged into the console."
msgstr "Activado, o jogo vê o comando deste jogador como ligado à consola."

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Connected"
msgstr "Conectado"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Controller"
msgstr "Comando"

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/nxemu/ui/views/controller_dialog.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Left stick"
msgstr "Comando esquerdo"

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Deadzone"
msgstr "Zona morta"

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Range"
msgstr "Amplitude"

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Modifier range"
msgstr "Amplitude com modificador"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "D-pad"
msgstr "Teclado direcional"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "On, the controller shakes when games ask it to."
msgstr "Activado, o comando vibra quando o jogo o solicita."

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Face buttons"
msgstr "Botões de ação"

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/nxemu/ui/views/controller_dialog.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Right stick"
msgstr "Comando direito"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Asks for each control in turn"
msgstr "Solicite cada comando de cada vez"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Bind all controls"
msgstr "Atribuir todos os controlos"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Binds this player's controls as the input device suggests"
msgstr "Atribui os controlos deste jogador conforme sugerido pelo dispositivo de entrada"

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Cancel"
msgstr "Cancelar"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Save"
msgstr "Guardar"

#: src/nxemu/ui/assets/directories_dialog.rml
msgid "Add the directories your games are in. Updates, DLC and mods in the same directories are matched to their games automatically. Turn on Scan subfolders to also look in the folders inside a directory."
msgstr "Adicione as pastas onde estão os seus jogos. As atualizações, DLC e mods nessas pastas são associados automaticamente aos seus jogos. Ative Procurar em subpastas para procurar também nas pastas que contêm."

#: src/nxemu/ui/assets/directories_dialog.rml
msgid "Add a directory"
msgstr "Adicionar pasta"

#: src/nxemu/ui/assets/directories_dialog.rml
msgid "The game directories cannot change while a game is running."
msgstr "As pastas do jogo não podem ser editadas enquanto um jogo está em curso."

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Install firmware"
msgstr "Instalar firmware"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Source"
msgstr "Fonte"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Install"
msgstr "Instalar"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Finish"
msgstr "Concluir"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Where is the firmware?"
msgstr "Onde está o firmware?"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Most games need the console's firmware. Choose the package to install it from, or drop it on this window."
msgstr "A maioria dos jogos requer firmware de consola. Escolha o ficheiro para instalar ou solte-o nesta janela."

