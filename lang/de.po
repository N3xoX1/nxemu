#: src/nxemu/ui/assets/directories_dialog.rml
msgid "Add the directories your games are in. Updates, DLC and mods in the same directories are matched to their games automatically. Turn on Scan subfolders to also look in the folders inside a directory."
msgstr "Füge die Ordner hinzu, in denen deine Spiele liegen. Updates, DLC und Mods in denselben Ordnern werden ihren Spielen automatisch zugeordnet. Schalte Unterordner durchsuchen ein, um auch in den Ordnern darin zu suchen."

#: src/nxemu/ui/assets/directories_dialog.rml
msgid "Add a directory"
msgstr "Verzeichnis hinzufügen"

#: src/nxemu/ui/assets/directories_dialog.rml
msgid "The game directories cannot change while a game is running."
msgstr "Spieleverzeichnisse können während eines laufenden Spiels nicht geändert werden."

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Install firmware"
msgstr "Firmware installieren"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Source"
msgstr "Quelle"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Install"
msgstr "Installieren"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Finish"
msgstr "Fertigstellen"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Where is the firmware?"
msgstr "Wo befindet sich die Firmware?"

