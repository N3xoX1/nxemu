#: src/nxemu/ui/views/advanced_dialog.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "None"
msgstr "なし"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The picture as the game draws it."
msgstr "ゲームが生成するイメージ。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Light work, a little blur. The steadier picture at low resolutions."
msgstr "要求が厳しくなく、わずかにぼやけています。低解像度でもより安定した画像。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The best picture, for more work."
msgstr "最高の画像ですが、要求はさらに厳しくなります。"

#: src/nxemu/ui/views/advanced_dialog.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Automatic"
msgstr "自動"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Follows the resolution chosen."
msgstr "選択した解像度に従います。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "As the game asks"
msgstr "ゲームによって異なる"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "What the console would do."
msgstr "コンソールと同じように。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The sharpest. Light work for most graphics devices."
msgstr "最も鮮明です。多くのグラフィックスデバイスで負荷が低くなります。"

#: src/nxemu/ui/views/advanced_dialog.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Normal"
msgstr "通常"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The fastest. Most games look right; particles often do not."
msgstr "最速。ほとんどのゲームは正しく表示されますが、パーティクルが正しく表示されないことがよくあります。"

#: src/nxemu/ui/views/advanced_dialog.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "High"
msgstr "高"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "What some games need to look right. Some need it from their start."
msgstr "一部のゲームを正しく表示するために必要です。起動時から必要なゲームもあります。"

#: src/nxemu/ui/views/advanced_dialog.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Extreme"
msgstr "エクストリーム"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Slow: to look for a fault."
msgstr "遅い: 問題を確認するため。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "As the accuracy level"
msgstr "精度レベルに応じて"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Safe when the accuracy level is High or Extreme."
msgstr "精度レベルが High または Extreme の場合は安全です。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Unsafe"
msgstr "安全性を優先しない"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Faster."
msgstr "高速化。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Safe"
msgstr "わかりました"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Steadier: it fixes some games."
msgstr "より安定しました: いくつかのゲームを修正しました。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Processor"
msgstr "プロセッサー"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The slowest, and the safest."
msgstr "最も遅く、最も安全です。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The usual choice."
msgstr "通常の選択。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Processor, in the background"
msgstr "CPU、バックグラウンド"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "No stutter, but textures show wrong until they are decoded."
msgstr "途切れはありませんが、デコードされるまでテクスチャが正しくありません。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The best picture, and the most memory."
msgstr "最高の画像と最高のメモリ消費量。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "BC1 (low quality)"
msgstr "BC1 (低品質)"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The least memory."
msgstr "メモリ消費量が最も少ない。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "BC3 (medium quality)"
msgstr "BC3 (中品質)"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Less memory."
msgstr "メモリが少なくなっています。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Conservative"
msgstr "慎重です"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Leaves memory to the other applications."
msgstr "他のアプリケーション用にメモリを残します。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Aggressive"
msgstr "アグレッシブ"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Takes what there is: other applications can slow down. No effect on graphics built into the processor."
msgstr "利用可能なメモリをすべて使用します。他のアプリケーションの速度が低下する可能性があります。プロセッサに統合されたグラフィックス チップには影響しません。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The fastest in most cases."
msgstr "ほとんどの場合最速。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "When the graphics device shows videos wrong."
msgstr "グラフィックス デバイスでビデオが正しく表示されない場合。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Videos stay black."
msgstr "ビデオは黒いままです。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Translated (Dynarmic)"
msgstr "コード変換 (Dynarmic)"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "The code is translated for this computer's processor. Runs every game."
msgstr "コードは、このコンピュータのプロセッサ用に変換されます。すべてのゲームと互換性があります。"

