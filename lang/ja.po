msgid "Accurate"
msgstr "正確"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Slower: for a game that misbehaves."
msgstr "低速です。正常に動作しないゲーム向けです。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Faster, and some games break."
msgstr "高速化されましたが、一部のゲームが動作しなくなりました。"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Paranoid"
msgstr "パラノイド"

#: src/nxemu/ui/views/advanced_dialog.cpp
msgid "Very slow: to look for a fault."
msgstr "非常に遅い: 問題を確認するため。"

