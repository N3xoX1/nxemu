msgid "A game is running: what is greyed out cannot change until it stops."
msgstr "Un jeu est en cours : les options grisées ne peuvent pas être modifiées avant son arrêt."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Picture"
msgstr "Image"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Anti-aliasing"
msgstr "Anticrénelage"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Smooths jagged edges."
msgstr "Lisse les bords en escalier."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Anisotropic filtering"
msgstr "Filtrage anisotrope"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps textures sharp seen at a slant."
msgstr "Préserve la netteté des textures vues en biais."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Accuracy"
msgstr "Précision"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Accuracy level"
msgstr "Niveau de précision"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How closely the graphics chip is imitated."
msgstr "La fidélité avec laquelle la puce graphique est émulée."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Videos at their own speed"
msgstr "Vidéos à leur vitesse normale"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Even when the speed is not limited."
msgstr "Même lorsque la vitesse n'est pas limitée."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Textures and video"
msgstr "Textures et vidéo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "ASTC recompression"
msgstr "Recompression ASTC"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Less graphics memory, for a lesser picture."
msgstr "Moins de mémoire graphique, au prix d'une image moins fidèle."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Graphics memory"
msgstr "Mémoire graphique"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How much of it games may take."
msgstr "La quantité que les jeux peuvent utiliser."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shaders"
msgstr "Shaders"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keep shaders on the disk"
msgstr "Conserver les shaders sur le disque"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Games stutter less from their second start."
msgstr "Les jeux saccadent moins dès leur deuxième lancement."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off only to look for a fault."
msgstr "À désactiver uniquement pour rechercher un problème."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Build shaders in the background"
msgstr "Compiler les shaders en arrière-plan"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Less stutter; things can show late. A hack."
msgstr "Moins de saccades ; certains éléments peuvent apparaître en retard. Une approximation."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Performance"
msgstr "Performances"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keep the graphics device busy"
msgstr "Maintenir le périphérique graphique occupé"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "So that it does not slow its clock. Uses more power."
msgstr "Évite qu'il réduise sa fréquence. Consomme plus d'énergie."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor and memory"
msgstr "Processeur et mémoire"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Console memory"
msgstr "Mémoire de la console"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "More than the console has: for heavy mods."
msgstr "Plus que sur la console : pour les mods exigeants."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Emulation"
msgstr "Émulation"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/hotkeys.h
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Limit speed"
msgstr "Limiter la vitesse"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off: as fast as the computer can."
msgstr "Désactivé : aussi vite que l'ordinateur le permet."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "On, games run at the speed chosen: 100% is the speed of the console."
msgstr "Activé, les jeux tournent à la vitesse choisie : 100 % correspond à la vitesse de la console."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Audio"
msgstr "Audio"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output device"
msgstr "Périphérique de sortie"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Where the sound of games is played."
msgstr "Où le son des jeux est diffusé."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output mode"
msgstr "Mode de sortie"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Surround needs speakers that play it."
msgstr "Le son surround nécessite des enceintes compatibles."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Output engine"
msgstr "Moteur de sortie"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What plays the sound on this computer."
msgstr "Ce qui joue le son sur cet ordinateur."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Input device"
msgstr "Périphérique d'entrée"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The microphone games listen to."
msgstr "Le microphone utilisé par les jeux."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
#: src/nxemu/ui/assets/main_window.rml
#: src/nxemu/ui/views/hotkeys.h
#: src/nxemu/ui/views/main_window.cpp
#: src/android/app/src/main/jni/ui/ui_activity.cpp
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Controllers"
msgstr "Manettes"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Vibration"
msgstr "Vibration"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "For every player. Each has a switch of their own."
msgstr "Pour tous les joueurs. Chacun dispose aussi de son propre réglage."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Behaviour"
msgstr "Comportement"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/main_window.cpp
msgid "Start games in fullscreen"
msgstr "Démarrer les jeux en plein écran"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/views/main_window.cpp
msgid "Start games with UI hidden"
msgstr "Démarrer les jeux avec l'interface masquée"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Confirm before stopping"
msgstr "Confirmer avant l'arrêt"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Asks before a running game is stopped."
msgstr "Demande confirmation avant d'arrêter un jeu en cours."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Discord presence"
msgstr "Présence Discord"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shows what you play in Discord when it runs."
msgstr "Affiche ce à quoi vous jouez dans Discord lorsqu'il est ouvert."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Emulation diagnostics"
msgstr "Diagnostic de l’émulation"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor engine"
msgstr "Moteur du processeur"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How the game's code is run."
msgstr "La façon dont le code du jeu est exécuté."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Processor accuracy"
msgstr "Précision du processeur"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "For the engine that translates the code."
msgstr "Pour le moteur qui traduit le code."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Driver pipeline cache"
msgstr "Cache des pipelines du pilote"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Shaders load faster with some drivers."
msgstr "Accélère le chargement des shaders avec certains pilotes."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Memory reads"
msgstr "Lectures mémoire"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "How carefully the chip reads what games write."
msgstr "La rigueur avec laquelle la puce lit les données écrites par les jeux."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Command synchronization"
msgstr "Synchronisation des commandes"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps the order games give their commands in."
msgstr "Respecte l'ordre des commandes envoyées par les jeux."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Slower, and steadier. Off, some games show faults, hang or crash."
msgstr "Plus lent, mais plus stable. Sans cette option, certains jeux présentent des défauts, se figent ou plantent."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Fast readback"
msgstr "Relecture rapide"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Lets games read what the chip drew without waiting for it."
msgstr "Permet aux jeux de lire ce que la puce a dessiné sans l'attendre."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Needs High or Extreme accuracy. Much faster in some games, keeping High drawing. What games read can be a frame late."
msgstr "Nécessite la précision Élevée ou Extrême. Bien plus rapide dans certains jeux, avec le dessin de la précision Élevée. Ce que les jeux lisent peut avoir une image de retard."

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Reactive flushing"
msgstr "Vidage réactif"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Brings memory up to date when it is read."
msgstr "Met la mémoire à jour au moment de sa lecture."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "More exact than guessing ahead when it will be read."
msgstr "Plus précis que d'anticiper le moment de sa lecture."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Barrier feedback loops"
msgstr "Boucles de rétroaction de barrière"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Draws transparent things right in some games."
msgstr "Affiche correctement les éléments transparents dans certains jeux."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Fast GPU time"
msgstr "Temps GPU rapide"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Most games then draw their highest resolution."
msgstr "La plupart des jeux utilisent alors leur résolution maximale."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Games that lower their resolution when the chip is slow are told it is fast."
msgstr "Indique que la puce est rapide aux jeux qui réduisent leur résolution lorsqu'elle est lente."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "ASTC decoding"
msgstr "Décodage ASTC"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What decodes the textures of this kind."
msgstr "Ce qui décode les textures de ce type."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Video decoding"
msgstr "Décodage vidéo"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What decodes the videos of games."
msgstr "Ce qui décode les vidéos des jeux."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Threads and input"
msgstr "Threads et entrées"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Graphics on their own thread"
msgstr "Graphismes sur un thread dédié"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Should stay on."
msgstr "À laisser activé."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Presentation on its own thread"
msgstr "Présentation sur un thread dédié"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "A little faster on some computers."
msgstr "Un peu plus rapide sur certains ordinateurs."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Multicore"
msgstr "Multicœur"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The cores of the console on as many threads."
msgstr "Les cœurs de la console sur autant de threads."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Off, games run on one thread: much slower, to look for a fault."
msgstr "Sans cette option, les jeux utilisent un seul thread : bien plus lent, pour rechercher un problème."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "CPU and system in step"
msgstr "Synchroniser le CPU et le système"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Keeps the processor and the system's answers in order."
msgstr "Respecte l'ordre entre le processeur et les réponses du système."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Needs multicore."
msgstr "Nécessite le mode multicœur."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Accurate vibration"
msgstr "Vibrations précises"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Every change is sent: some controllers lag."
msgstr "Chaque variation est transmise : certaines manettes réagissent en retard."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Log"
msgstr "Journal"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Show CPU backend in the title bar"
msgstr "Afficher le backend CPU dans la barre de titre"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The active backend, instruction set and address-space width."
msgstr "Le backend actif, le jeu d'instructions et la largeur de l'espace d'adressage."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Show the log console"
msgstr "Afficher la console du journal"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "The log is also written as it comes."
msgstr "Le journal s'y affiche aussi au fur et à mesure."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Log filter"
msgstr "Filtre du journal"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "What is written, as class:level."
msgstr "Ce qui est consigné, sous la forme classe:niveau."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Click a shortcut, then press the keys or hold and release the gamepad buttons. To clear it, use the cross beside it, or click it and press Delete."
msgstr "Cliquez sur un raccourci, puis appuyez sur les touches ou maintenez et relâchez les boutons de la manette. Pour l’effacer, utilisez la croix à côté, ou cliquez dessus puis appuyez sur Suppr."

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "In game"
msgstr "En jeu"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Restore defaults"
msgstr "Rétablir les valeurs par défaut"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Inherit all settings"
msgstr "Hériter de tous les paramètres"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Restore the defaults of all the tabs?"
msgstr "Rétablir les valeurs par défaut de tous les onglets ?"

#: src/nxemu/ui/assets/advanced_dialog.rml
msgid "Remove your overrides and re-enable NXEmu settings for this game?"
msgstr "Supprimer vos personnalisations et réactiver les paramètres NXEmu pour ce jeu ?"

#: src/nxemu/ui/assets/advanced_dialog.rml
#: src/nxemu/ui/assets/profiles_dialog.rml
