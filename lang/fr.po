msgstr "Activé, le jeu voit la manette de ce joueur comme connectée à la console."

#: src/nxemu/ui/assets/controller_dialog.rml
#: src/android/app/src/main/jni/ui/ui_settings_pages.cpp
msgid "Connected"
msgstr "Connecté"

#: src/nxemu/ui/assets/controller_dialog.rml
msgid "Controller"
