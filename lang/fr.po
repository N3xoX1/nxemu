#: src/nxemu/ui/assets/directories_dialog.rml
msgid "Add the directories your games are in. Updates, DLC and mods in the same directories are matched to their games automatically. Turn on Scan subfolders to also look in the folders inside a directory."
msgstr "Ajoutez les dossiers où se trouvent vos jeux. Les mises à jour, DLC et mods de ces dossiers sont associés automatiquement à leurs jeux. Activez Analyser les sous-dossiers pour chercher aussi dans les dossiers qu'ils contiennent."

#: src/nxemu/ui/assets/directories_dialog.rml
msgid "Add a directory"
msgstr "Ajouter un dossier"

#: src/nxemu/ui/assets/directories_dialog.rml
msgid "The game directories cannot change while a game is running."
msgstr "Les dossiers de jeux ne peuvent pas être modifiés pendant qu'un jeu est en cours."

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Install firmware"
msgstr "Installer un firmware"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Source"
msgstr "Source"

#: src/nxemu/ui/assets/firmware_dialog.rml
msgid "Install"
msgstr "Installer"

#: src/nxemu/ui/assets/firmware_dialog.rml
